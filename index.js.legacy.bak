/*  GET All Enabled AI Chat Channels (Global)                        */
/* ------------------------------------------------------------------ */
app.get('/api/aichat/enabled', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    const channels = botEnabledAiChannels.get('global') || [];

    // Request fresh data if empty
    if (channels.length === 0) {
        const targetBot = Array.from(activeBots.values()).find(bot =>
            bot.userId === userId
        );

        if (targetBot) {
            console.log(`📡 Requesting enabled AI chat channels`);
            io.to(targetBot.socketId).emit('config_command', {
                command: 'get_enabled_aichat_channels',
                serverId: 'global',
                payload: {},
                timestamp: Date.now()
            });
        }
    }

    res.json({ success: true, channels, count: channels.length });
});

/* ------------------------------------------------------------------ */
/*  REFRESH AI Chat Data                                              */
/* ------------------------------------------------------------------ */
app.post('/api/refresh/aichat', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;

    // Send cached AI chat configs
    for (const [srvId, config] of botAiChatConfigs) {
        io.to(`user_${userId}`).emit('server_aichat_updated', {
            serverId: srvId,
            config
        });
    }

    // Send enabled channels
    const enabledChannels = botEnabledAiChannels.get('global') || [];
    io.to(`user_${userId}`).emit('aichat_enabled_channels_updated', {
        channels: enabledChannels,
        count: enabledChannels.length
    });

    res.json({ success: true, message: 'AI Chat data resent' });
});

/* ------------------------------------------------------------------ */
/*  BULK AI Chat Operations                                           */
/* ------------------------------------------------------------------ */
// Enable AI chat for multiple servers
app.post('/api/aichat/bulk/enable', ensureAuthenticated, (req, res) => {
    const { serverIds } = req.body;
    const userId = req.user.id;

    if (!Array.isArray(serverIds)) {
        return res.status(400).json({ success: false, message: 'serverIds must be an array' });
    }

    let successCount = 0;
    serverIds.forEach(serverId => {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            io.to(targetBot.socketId).emit('config_command', {
                command: 'enable_aichat',
                serverId,
                payload: { userId },
                timestamp: Date.now()
            });
            successCount++;
        }
    });

    res.json({
        success: true,
        message: `Enable command sent to ${successCount} servers`,
        processed: successCount,
        total: serverIds.length
    });
});

// Disable AI chat for multiple servers
