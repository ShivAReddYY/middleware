// Get all API keys (server-scoped)
app.get('/api/gemini/keys', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    const { page = 1, limit = 10, serverId } = req.query;

    debugLogger.logApiRequest('GET', '/api/gemini/keys', { userId, serverId });

    if (!serverId) {
        return res.status(400).json({ success: false, message: 'serverId is required' });
    }

    const serverData = botGeminiData.get(serverId) || { apiKeys: [], stats: {}, lastUpdated: 0 };
    let apiKeys = serverData.apiKeys || [];

    // Pagination
    const startIndex = (parseInt(page) - 1) * parseInt(limit);
    const paginatedKeys = apiKeys.slice(startIndex, startIndex + parseInt(limit));

    const pagination = {
        current: parseInt(page),
        total: Math.ceil(apiKeys.length / parseInt(limit)),
        hasNext: startIndex + parseInt(limit) < apiKeys.length,
        hasPrev: parseInt(page) > 1,
        totalItems: apiKeys.length
    };

    console.log(`🔍 Gemini API keys list called for server ${serverId}, found ${apiKeys.length} keys`);

    // Request fresh data if no data
    if (!serverData.apiKeys || serverData.apiKeys.length === 0) {
        const targetBot = Array.from(activeBots.values()).find(bot => bot.userId === userId);
        if (targetBot) {
            console.log(`📡 Requesting fresh Gemini data for server ${serverId}`);
            io.to(targetBot.socketId).emit('config_command', {
                command: 'get_all_gemini_api_keys',
                serverId, // Root level for bot compatibility
                payload: { serverId, options: { page: parseInt(page), limit: parseInt(limit) } },
                timestamp: Date.now()
            });
        }
    }

    res.json({ success: true, apiKeys: paginatedKeys, pagination, serverId });
});

