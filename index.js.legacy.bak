                io.to(`user_${botData.userId}`).emit('notification_error', payload);
                break;

            // ═══════ RULES SYSTEM ═══════
            case 'rules_data': {
                if (payload.templates) {
                    botRulesData.set('templates', payload.templates);
                }
                io.to(`user_${botData.userId}`).emit('rules_data_updated', payload);
                break;
            }
            case 'rules_templates': {
                if (payload.templates) {
                    botRulesData.set('templates', payload.templates);
                }
                io.to(`user_${botData.userId}`).emit('rules_templates_updated', payload);
                break;
            }

            // ═══════ STICKY MESSAGE SYSTEM ═══════
            case 'server_stickymessage_config':
            case 'stickymessage_config': {
                if (!payload || !payload.serverId) break;
                const srvId = String(payload.serverId);
                if (payload.configs) {
                    botStickyMessageConfigs.set(srvId, payload.configs);
                }
                io.to(`user_${botData.userId}`).emit('server_stickymessage_updated', { serverId: srvId, configs: payload.configs });
                break;
            }
            case 'stickymessage_deleted': {
                if (!payload || !payload.serverId) break;
                botStickyMessageConfigs.delete(String(payload.serverId));
                io.to(`user_${botData.userId}`).emit('server_stickymessage_deleted', { serverId: payload.serverId });
                break;
            }
            case 'stickymessage_error':
                io.to(`user_${botData.userId}`).emit('stickymessage_error', payload);
                break;

            // ═══════ EMBEDS SYSTEM ═══════
            case 'server_embeds_data': {
                if (!payload || !payload.serverId) break;
                const srvId = String(payload.serverId);
                botEmbedsData.set(srvId, payload.data || { embeds: [], schedules: [] });
                io.to(`user_${botData.userId}`).emit('server_embeds_updated', { serverId: srvId, data: payload.data });
                console.log(`📋 Embeds data stored for server ${srvId}`);
                break;
            }
            case 'embeds_list': {
                if (!payload || !payload.serverId) break;
                const srvId = String(payload.serverId);
                const existing = botEmbedsData.get(srvId) || { embeds: [], schedules: [] };
                existing.embeds = payload.data?.embeds || [];
                botEmbedsData.set(srvId, existing);
                io.to(`user_${botData.userId}`).emit('embeds_list_updated', { serverId: srvId, data: payload.data });
                break;
            }
            case 'embeds_update': {
                if (!payload || !payload.serverId) break;
                const srvId = String(payload.serverId);
                // Invalidate cache so next GET fetches fresh data from bot
                botEmbedsData.delete(srvId);
                io.to(`user_${botData.userId}`).emit('embeds_updated', { serverId: srvId, data: payload.data });
                break;
            }
            case 'embeds_schedules': {
                if (!payload || !payload.serverId) break;
                const srvId = String(payload.serverId);
                const existing2 = botEmbedsData.get(srvId) || { embeds: [], schedules: [] };
                existing2.schedules = payload.data?.schedules || [];
                botEmbedsData.set(srvId, existing2);
                io.to(`user_${botData.userId}`).emit('embeds_schedules_updated', { serverId: srvId, data: payload.data });
                break;
            }
        }

        // ═══ Resolve any pending REST requests waiting for this event ═══
        resolvePendingRequests(socket.id, type, payload);
    });


    socket.on('dashboard_command', async (data) => {
        const { command, serverId, payload } = data;

        console.log('🔍 Dashboard Command:', command, 'for server:', serverId);

        try {
            // Convert Discord ID to MongoDB ObjectId for database operations
            const discordId = socket.userId; // Discord ID from dashboard connection
            const userDoc = await UserModel.findOne({ discordId });

            if (!userDoc) {
                console.log('❌ User not found for discordId:', discordId);
                return;
            }

            const mongoUserId = userDoc._id.toString();
            console.log('🔄 Converted discordId', discordId, 'to mongoUserId', mongoUserId);

            // Find bot using permission-aware approach (bot owner, server owner, or bot manager)
            const userGuilds = socket.userGuilds || []; // Stored during dashboard_connect
            const targetBot = findBotForServer(discordId, serverId, userGuilds);

            if (targetBot) {
                console.log('✅ Forwarding dashboard command to bot');

                io.to(targetBot.socketId).emit('config_command', {
                    command,
                    serverId,
                    payload: {
                        ...payload,
                        mongoUserId // ✅ Send MongoDB ObjectId to bot for database operations
                    },
                    timestamp: Date.now()
                });
            } else {
                console.log('❌ No target bot found for dashboard command');
            }

        } catch (error) {
            console.error('❌ Dashboard command error:', error);
        }
    });

    // ═══ Generic config protocol: bot lifecycle acknowledgments ═══
    // Bots emit this after processing a 'config:dispatch' — see lib/configProtocol.js
    socket.on('config:ack', (ackPayload) => {
        configProtocol.handleAck(ackPayload);
    });

    // Handle disconnection
    socket.on('disconnect', () => {
        console.log(`Socket disconnected: ${socket.id}`);

        debugLogger.logEvent('socket', 'disconnect', {
            socketId: socket.id,
            botId: socket.botId,
            userId: socket.userId
        });

        // Remove bot if it was a bot connection
        if (socket.botId) {
            activeBots.delete(socket.botId);
            debugLogger.updateActiveBots(activeBots);
            console.log(`Bot ${socket.botId} disconnected`);

            // Clean up any pending requests for this bot's socket
            for (const [requestId, pending] of pendingRequests) {
                if (pending.socketId === socket.id) {
                    clearTimeout(pending.timeout);
                    pendingRequests.delete(requestId);
                    try {
                        pending.res.status(503).json({ success: false, message: 'Bot disconnected while processing request' });
                    } catch { /* response may already be sent */ }
                }
            }

            // Fail any in-flight generic config protocol requests for this bot
            configProtocol.handleBotDisconnect(socket.id);
        }

        // Remove user session if it was a dashboard connection
        if (socket.userId) {
            userSessions.delete(socket.userId);
            debugLogger.updateUserSessions(userSessions);
        }

        // Remove socket connection
        delete debugLogger.debugData.connections.socketConnections[socket.id];

        debugLogger.updateStatistics(activeBots, userSessions);
    });
});

// Discord Auth Routes
app.get('/auth/discord', (req, res, next) => {
    debugLogger.logApiRequest('GET', '/auth/discord');
    // Use custom OAuth URL with guild_id to prompt server join
    const params = new URLSearchParams({
        client_id: CLIENT_ID,
        redirect_uri: CALLBACK_URL,
        response_type: 'code',
        scope: 'identify guilds guilds.join',
        guild_id: REQUIRED_GUILD_ID,
        disable_guild_select: 'true'
    });
    res.redirect(`https://discord.com/api/oauth2/authorize?${params.toString()}`);
});

app.get('/auth/discord/callback',
    passport.authenticate('discord', {
        failureRedirect: `${FRONTEND_URL}/login` // Better redirect
    }),
    async (req, res) => {
        debugLogger.logApiRequest('GET', '/auth/discord/callback', {}, {
            status: 302,
            redirect: `${FRONTEND_URL}/dashboard`,
            userId: req.user?.id
        });

        console.log(`✅ OAuth SUCCESS! User: ${req.user?.username}`);

        // NOTE: We no longer fetch guilds from Discord API
        // Permission checks now use bot's cached data (botGuildData, botServerConfigs)
        // This eliminates rate limiting issues!
        req.session.userGuilds = []; // Keep empty for backward compatibility

        console.log(`🔄 Redirecting to dashboard...`);
        console.log(`📝 Session ID: ${req.sessionID}`);
        console.log(`🔍 isAuthenticated: ${req.isAuthenticated()}`);

        // Save session before redirect
        req.session.save((err) => {
            if (err) {
                console.error('❌ Session save error:', err);
            } else {
                console.log('✅ Session saved successfully');
            }
            res.redirect(`${FRONTEND_URL}/dashboard`);
        });
    }
);


app.get('/auth/logout', (req, res) => {
