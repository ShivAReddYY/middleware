// Error types that any command might produce
const ERROR_TYPES = new Set([
    'ticket_error', 'application_error', 'autoresponder_error', 'autovoice_error',
    'command_error', 'rolenick_error', 'aichat_error', 'serverconfig_error',
    'verification_error', 'invitetracker_error', 'quarantine_error', 'serverlog_error',
    'welcome_error', 'leave_error', 'suggestion_error', 'nqn_error', 'autorole_error',
    'hentai_error', 'commandlogs_error', 'afk_error', 'giveaway_error', 'reaction_role_error',
    'gemini_error', 'anti_system_error', 'lock_role_error', 'role_persist_error',
    'boycott_ban_error', 'birthday_error', 'boost_error', 'counting_error', 'faq_error',
    'leveling_error', 'modmail_error', 'notification_error', 'truthordare_error',
    'guild_data_error'
]);

// ════════════════════════════════════════════════════════════════════════════
// PENDING REQUESTS MAP — one central lookup instead of per-request listeners
// ════════════════════════════════════════════════════════════════════════════
// Key:   requestId (unique string)
// Value: { res, serverId, expectedTypes, timeout, command, createdAt }
const pendingRequests = new Map();

/**
 * Called from the main bot_data_update handler after each event is processed.
 * Checks if any pending REST request is waiting for this event type + serverId.
 */
function resolvePendingRequests(socketId, type, payload) {
    const dataServerId = payload?.serverId || payload?.guildId;
    if (!dataServerId) return;

    const isError = ERROR_TYPES.has(type);

    for (const [requestId, pending] of pendingRequests) {
        // Must match the same bot socket and server
        if (pending.socketId !== socketId || pending.serverId !== dataServerId) continue;

        const isMatch = pending.expectedTypes.includes(type);

        if (isMatch) {
            clearTimeout(pending.timeout);
            pendingRequests.delete(requestId);
            if (typeof pending.customResolve === 'function') {
                pending.res.json(pending.customResolve(payload));
            } else {
                pending.res.json({ success: true, data: payload });
            }
            return;
        }

        if (isError) {
            clearTimeout(pending.timeout);
            pendingRequests.delete(requestId);
            pending.res.json({
                success: false,
                message: payload?.error || payload?.message || 'Operation failed',
                data: payload
            });
            return;
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════
// GENERIC CONFIG DISPATCH — production-grade replacement for forwardCommand().
// Every module can opt in by calling this from its route handler. It routes
// through ConfigProtocol so the dashboard gets full lifecycle events
// (sending → received → processing → success/failed/timeout) instead of a
// single fire-and-forget response.
//
// `moduleName`/`action` are free-form strings used purely for envelope
// labelling and bot-side routing — the middleware has zero built-in
// knowledge of what any module does.
// ════════════════════════════════════════════════════════════════════════════
async function dispatchConfig(req, res, { serverId, module: moduleName, action, payload = {} }) {
    const userId = req.user.id;
    const userGuilds = req.session?.userGuilds || [];

    const targetBot = findBotForServer(userId, serverId, userGuilds);
    if (!targetBot) {
        return res.status(404).json({
            success: false,
            state: 'failed',
            error: 'bot_offline',
            message: 'Server not found or bot offline'
        });
    }

    const botSocket = io.sockets.sockets.get(targetBot.socketId);
    if (!botSocket) {
        return res.status(404).json({ success: false, state: 'failed', error: 'bot_socket_missing', message: 'Bot socket not found' });
    }

    // `activeBots` is keyed by botId but findBotForServer() returns the bot
    // data object without its Map key, so resolve it here for the envelope.
    let resolvedBotId = null;
    for (const [id, bot] of activeBots) {
        if (bot.socketId === targetBot.socketId) { resolvedBotId = id; break; }
    }

    const result = await configProtocol.dispatch({
        botSocketId: targetBot.socketId,
        botId: resolvedBotId,
        serverId,
        userId: targetBot.userId,
        module: moduleName,
        action,
        payload
    });

    const httpStatus = result.success ? 200 : (result.error === 'timeout' ? 504 : 400);
    res.status(httpStatus).json(result);
}

function forwardCommand(req, res, serverId, command, payload) {
    const userId = req.user.id;
    const userGuilds = req.session?.userGuilds || [];

    const targetBot = findBotForServer(userId, serverId, userGuilds);

    if (!targetBot) {
        debugLogger.logApiRequest('CMD', command, { serverId }, { status: 404, message: 'Bot offline or no access' });
        return res.status(404).json({ success: false, message: 'Server not found or bot offline' });
    }

    const botSocket = io.sockets.sockets.get(targetBot.socketId);
    if (!botSocket) {
        return res.status(404).json({ success: false, message: 'Bot socket not found' });
    }

    const expectedTypes = COMMAND_RESPONSE_MAP[command] || [];

    // If we don't know what response to expect, fire-and-forget (backwards compat)
    if (expectedTypes.length === 0) {
        io.to(targetBot.socketId).emit('config_command', {
            command, serverId, payload,
            timestamp: Date.now()
        });
        return res.json({ success: true, message: `${command} request sent` });
    }

    // Register in PendingRequests Map
    const requestId = `${command}_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;

    const timeout = setTimeout(() => {
        if (pendingRequests.has(requestId)) {
            pendingRequests.delete(requestId);
            console.log(`⏰ Timeout: ${command} (server: ${serverId}, req: ${requestId})`);
            res.status(504).json({ success: false, message: 'Bot did not respond in time. Please try again.' });
        }
    }, 10000);

    pendingRequests.set(requestId, {
        res,
        socketId: targetBot.socketId,
        serverId,
        expectedTypes,
        timeout,
        command,
        createdAt: Date.now()
    });

    // Send command to bot
    io.to(targetBot.socketId).emit('config_command', {
        command, serverId, payload,
        requestId,
        timestamp: Date.now()
    });
}
// Command Management Routes
// Command Management Routes - Add these to your middleware
app.get('/api/server/:serverId/commands/disabled', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;

    debugLogger.logApiRequest('GET', `/api/server/${serverId}/commands/disabled`, { serverId, userId });

    const commands = botDisabledCommands.get(String(serverId)) || [];

    // Request fresh data if empty
    if (commands.length === 0) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            console.log(`📡 Requesting fresh disabled commands for server ${serverId}`);
            io.to(targetBot.socketId).emit('config_command', {
                command: 'get_disabled_commands',
                serverId,
                payload: {},
                timestamp: Date.now()
            });
        }
    }

    res.json({ success: true, commands });
});

