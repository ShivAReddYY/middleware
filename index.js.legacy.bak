// Get all applications for a server
app.get('/api/server/:serverId/applications', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;

    debugLogger.logApiRequest('GET', `/api/server/${serverId}/applications`, { serverId, userId });

    // Check if user has access to this server
    const targetBot = getAnyBotWithServer(serverId);

    if (!targetBot) {
        const response = { message: 'Server not found or bot offline' };
        debugLogger.logApiRequest('GET', `/api/server/${serverId}/applications`, { serverId, userId }, { status: 404, ...response });
        return res.status(404).json(response);
    }

    // Get applications from memory or request from bot
    const applications = botApplicationConfigs.get(String(serverId)) || [];

    if (applications.length === 0) {
        // Request from bot
        const botSocket = io.sockets.sockets.get(targetBot.socketId);
        if (botSocket) {
            botSocket.emit('config_command', {
                command: 'get_server_applications',
                serverId,
                payload: {},
                timestamp: Date.now()
            });
        }
    }

    const response = { applications };
    debugLogger.logApiRequest('GET', `/api/server/${serverId}/applications`, { serverId, userId }, { status: 200, count: applications.length });
    res.json(response);
});

// Create new application
app.post('/api/server/:serverId/applications', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;
    const { appName, mainChannel, responseChannel } = req.body;

    debugLogger.logApiRequest('POST', `/api/server/${serverId}/applications`, {
        serverId, userId, appName, mainChannel, responseChannel
    });

    if (!appName) {
        const response = { message: 'Application name is required' };
        debugLogger.logApiRequest('POST', `/api/server/${serverId}/applications`, req.body, { status: 400, ...response });
        return res.status(400).json(response);
    }

    // Find target bot
    const targetBot = getAnyBotWithServer(serverId);

    if (!targetBot) {
        const response = { message: 'Server not found or bot offline' };
        debugLogger.logApiRequest('POST', `/api/server/${serverId}/applications`, req.body, { status: 404, ...response });
        return res.status(404).json(response);
    }

    // Send command to bot
    const botSocket = io.sockets.sockets.get(targetBot.socketId);
    if (botSocket) {
        botSocket.emit('config_command', {
            command: 'create_application',
            serverId,
            payload: { appName, mainChannel, responseChannel },
            timestamp: Date.now()
        });
        botSocket.emit('config_command', {
            command: 'get_server_applications',
            serverId,
            payload: {},
            timestamp: Date.now()
        });
        const response = { success: true, message: 'Application creation request sent' };
        debugLogger.logApiRequest('POST', `/api/server/${serverId}/applications`, req.body, { status: 200, ...response });
        res.json(response);
    } else {
        const response = { message: 'Bot not available' };
        debugLogger.logApiRequest('POST', `/api/server/${serverId}/applications`, req.body, { status: 503, ...response });
        res.status(503).json(response);
    }
});

