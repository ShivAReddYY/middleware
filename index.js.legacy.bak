                    serverId: guildId
                });
                debugLogger.logEvent('socket', 'aichat_deleted', { serverId: guildId });
                break;
            }

            // AI chat enabled channels
            case 'aichat_enabled_channels': {
                botEnabledAiChannels.set('global', payload.channels || []);

                io.to(`user_${botData.userId}`).emit('aichat_enabled_channels_updated', {
                    channels: payload.channels || [],
                    count: payload.count || 0
                });
                debugLogger.logEvent('socket', 'aichat_enabled_channels_received', {
                    count: payload.count || 0
                });
                break;
            }

            // AI chat active check
            case 'aichat_active_check': {
                io.to(`user_${botData.userId}`).emit('aichat_active_check_result', {
                    serverId: payload.guildId,
                    channelId: payload.channelId,
