    if (req.isAuthenticated() && req.user) {
        //console.log(`✅ Sending user data: ${req.user.username}`);
        debugLogger.logApiRequest('GET', '/api/user', {}, {
            status: 200,
            userId: req.user.id,
            username: req.user.username
        });

        // Add CORS headers explicitly for this critical endpoint
        res.header('Access-Control-Allow-Credentials', 'true');
        res.header('Access-Control-Allow-Origin', FRONTEND_URL);

        res.json({
            id: req.user.id,
            username: req.user.username,
            global_name: req.user.global_name,
            avatar: req.user.avatar,
            email: req.user.email,
            verified: req.user.verified
        });
    } else {
        // console.log(`❌ User not authenticated`);
        // console.log('❌ Session missing user data');

        debugLogger.logApiRequest('GET', '/api/user', {}, {
            status: 401,
            message: 'Unauthorized',
            hasSession: !!req.session,
            hasPassport: !!req.session?.passport
        });

        res.status(401).json({
            error: 'Not authenticated',
            authenticated: false
        });
    }
    // console.log('🔍 ====================================\n');
});


app.post('/api/validate-bot', async (req, res) => {
    const { botId, userId, apiKey } = req.body;

    debugLogger.logApiRequest('POST', '/api/validate-bot', {
        botId,
        userId,
        hasApiKey: !!apiKey
    });

    if (!botId || !userId || !apiKey) {
        const response = { valid: false, message: 'Missing required parameters.' };
        debugLogger.logApiRequest('POST', '/api/validate-bot', req.body, { status: 400, ...response });
        return res.status(400).json(response);
    }

    try {
        console.log(`🔐 Bot connect attempt from botId: ${botId}, userId (discordId): ${userId}, socketId: ${socket.id}`);
        console.log(`🔎 Verifying API Key: ${apiKey}`);

        // Step 1: Find the user with discordId
        const user = await UserModel.findOne({ discordId: userId });

        if (!user) {
            console.log(`❌ No user found with discordId: ${userId}`);
            socket.emit('bot_auth_failed', { message: 'User not registered' });
            return;
        }

        // Step 2: Validate API key for that user._id
        const query = {
            userId: user._id, // Now using correct ObjectId
            keyValue: apiKey,
            isActive: true
        };

        console.log('📥 Running MongoDB query:', query);

        const keyDoc = await KeyModel.findOne(query);

        if (!keyDoc) {
            console.log('❌ No matching API key document found.');

            const allKeys = await KeyModel.find({});
            console.log('🗂️ Available keys in database:');
            for (const doc of allKeys) {
                const relatedUser = await UserModel.findById(doc.userId);
                console.log(`→ userId: ${doc.userId}, discordId: ${relatedUser?.discordId}, keyValue: ${doc.keyValue}, isActive: ${doc.isActive}`);
            }

            socket.emit('bot_auth_failed', { message: 'Invalid API key' });

            debugLogger.logEvent('socket', 'bot_auth_failed', {
                botId,
                userId,
                reason: 'Invalid API key'
            });

            return;
        }

        // Success: Register bot connection
        keyDoc.isActive = true;
        keyDoc.botId = botId;
        keyDoc.lastUsedAt = new Date();
        await keyDoc.save();

        const botData = {
            userId: user._id,
            socketId: socket.id,
            serverData: [],
            lastHeartbeat: Date.now(),
            authenticated: true,
            connectTime: Date.now()
        };

        activeBots.set(botId, botData);

        socket.botId = botId;
        socket.userId = user._id;
        socket.join(`bot_${botId}`);
        socket.join(`user_${user._id}`);

        debugLogger.debugData.connections.socketConnections[socket.id] = {
            connectTime: new Date().toISOString(),
            type: 'bot',
            userId: user._id,
            botId
        };

        socket.emit('bot_connected', { success: true });

        debugLogger.logEvent('socket', 'bot_connected', {
            botId,
            userId: user._id,
            socketId: socket.id
        });

        debugLogger.updateActiveBots(activeBots);
        debugLogger.updateStatistics(activeBots, userSessions);

        console.log(`✅ Bot ${botId} connected for user ${user._id}`);
    } catch (error) {
        console.error('❌ Bot connection error:', error);
        socket.emit('bot_auth_failed', { message: 'Connection failed' });
        debugLogger.logError(error, 'bot_connect');
    }


});

// Middleware to ensure the user is authenticated
function ensureAuthenticated(req, res, next) {
    if (req.isAuthenticated && req.isAuthenticated()) {
        return next();
    }
    debugLogger.logApiRequest(req.method, req.originalUrl, {}, {
        status: 401,
        message: 'Unauthorized'
    });
    res.status(401).json({ message: 'Unauthorized' });
};

// ============== PERMISSION SYSTEM ==============
const REQUIRED_GUILD_ID = process.env.REQUIRED_GUILD_ID;

// Layer 1: Guild Owner (uses bot's guild data - no rate limiting!)
function isGuildOwner(userId, serverId) {
    // Check from bot's cached guild data
    const guildData = botGuildData.get(String(serverId));
    if (guildData && guildData.owner === userId) {
        return true;
    }
    return false;
}

// Layer 2: Bot Manager (from in-memory botServerConfigs sent by bot)
function isBotManager(userId, serverId) {
    const config = botServerConfigs.get(String(serverId));

    // Debug logging
    console.log(`🔍 Bot Manager Check - User: ${userId}, Server: ${serverId}`);
    console.log(`   Config in memory: ${!!config}`);
    if (config) {
        console.log(`   Bot Managers: ${JSON.stringify(config.botManagers)}`);
        console.log(`   User in managers: ${config.botManagers?.includes(userId)}`);
    }

    return config?.botManagers?.includes(userId) || false;
}

// Combined permission check
function hasServerAccess(userId, serverId, userGuilds = []) {
    // Check if user is guild owner (uses bot's cached guild data)
    if (isGuildOwner(userId, serverId)) {
        return { allowed: true, role: 'server_owner' };
    }

    // Check if user is bot manager (uses in-memory serverConfigs)
    if (isBotManager(userId, serverId)) {
        return { allowed: true, role: 'bot_manager' };
    }

    return { allowed: false, role: null };
}

// Check required guild membership
function isInRequiredGuild(userGuilds) {
    if (!REQUIRED_GUILD_ID) return true; // Skip if not configured
    return userGuilds.some(g => g.id === REQUIRED_GUILD_ID);
}

// Simple helper: Get ANY bot that has the specified server (no permission check)
// Use this only after permission has already been validated!
function getAnyBotWithServer(serverId) {
    return Array.from(activeBots.values()).find(bot =>
        bot.serverData?.some(server => server.id === serverId)
    );
}

// Find a bot that has the specified server AND user has access
// Returns the bot data if found, null otherwise
function findBotForServer(userId, serverId, userGuilds = []) {
    // First try: find bot owned by this user that has the server
    const userOwnedBot = Array.from(activeBots.values()).find(bot =>
        bot.userId === userId &&
        bot.serverData?.some(server => server.id === serverId)
    );
    if (userOwnedBot) return userOwnedBot;

    // Second try: find ANY bot that has this server (for server owners and bot managers)
    const anyBot = Array.from(activeBots.values()).find(bot =>
        bot.serverData?.some(server => server.id === serverId)
    );

    if (!anyBot) return null;

    // Check if user has permission to access this server (using bot's cached data)
    if (isGuildOwner(userId, serverId)) return anyBot;
    if (isBotManager(userId, serverId)) return anyBot;

    return null;
}

// Middleware for server-specific access control
async function ensureServerAccess(req, res, next) {
    const serverId = req.params.serverId;
    const userId = req.user?.id;

    if (!userId || !serverId) {
        return res.status(401).json({ message: 'Unauthorized' });
    }

    // Get user's guilds from session
    const userGuilds = req.session?.userGuilds || [];

    // Check required guild membership first
    if (!isInRequiredGuild(userGuilds)) {
        return res.status(403).json({
            success: false,
            error: 'required_guild',
            message: 'You must join the GlaceYT Discord server to use this dashboard'
        });
    }

    // Bot owner check: if bot connected for this user owns this server, allow
    const botOwnerAccess = Array.from(activeBots.values()).find(bot =>
        bot.userId === userId && bot.serverData?.some(s => s.id === serverId)
    );
    if (botOwnerAccess) {
        req.accessRole = 'bot_owner';
        return next();
    }

    const access = await hasServerAccess(userId, serverId, userGuilds);
    if (!access.allowed) {
        return res.status(403).json({
            success: false,
            error: 'no_access',
            message: 'You do not have access to this server'
        });
    }

    req.accessRole = access.role;
    next();
}

// Get user's guilds from session
app.get('/api/user/guilds', ensureAuthenticated, (req, res) => {
    const guilds = req.session?.userGuilds || [];
    res.json({ success: true, guilds });
});

// Get accessible servers for the current user (main endpoint for dashboard)
app.get('/api/user/accessible-servers', ensureAuthenticated, async (req, res) => {
    const userId = req.user.id;
    const userGuilds = req.session?.userGuilds || [];

    // Collect ALL servers from all connected bots
    const allBotServers = [];
    for (const [botId, bot] of activeBots) {
        if (bot.serverData) {
            allBotServers.push(...bot.serverData.map(s => ({ ...s, botId, botUserId: bot.userId })));
        }
    }

    // If no bots connected
    if (allBotServers.length === 0) {
        return res.json({
            success: false,
            error: 'no_bot',
            message: "No bots are currently online."
        });
    }

    // Bot owner check FIRST - if this user's bot is connected, they get all their bot's servers
    // This bypasses the required guild check for bot owners
    const userBotServers = allBotServers.filter(s => s.botUserId === userId);
    if (userBotServers.length > 0) {
        return res.json({
            success: true,
            servers: userBotServers.map(s => ({ ...s, accessRole: 'bot_owner' })),
            role: 'bot_owner'
        });
    }

    // Note: Required guild check removed - users are auto-joined via OAuth

    // Server owners and bot managers: find servers they have access to
    const accessibleServers = [];

    console.log(`🔍 Checking access for user ${userId}`);
    console.log(`   Checking ${allBotServers.length} bot servers`);

    for (const server of allBotServers) {
        // Check if user is guild owner (using bot's cached data - no rate limiting!)
        const guildData = botGuildData.get(String(server.id));
        const isOwner = guildData && guildData.owner === userId;

        console.log(`   Server ${server.id} (${server.name}):`);
        console.log(`     - Guild data cached: ${!!guildData}`);
        if (guildData) {
            console.log(`     - Owner ID: ${guildData.owner}`);
            console.log(`     - Is owner: ${isOwner}`);
        }

        if (isOwner) {
            console.log(`     ✅ Access as server_owner`);
            accessibleServers.push({
                ...server,
                accessRole: 'server_owner'
            });
            continue;
        }

        // Check if user is bot manager
        if (isBotManager(userId, server.id)) {
            console.log(`     ✅ Access as bot_manager`);
            accessibleServers.push({
                ...server,
                accessRole: 'bot_manager'
            });
        }
    }

    // Handle no access scenario
    if (accessibleServers.length === 0) {
        // Check if user has ANY guilds with bot installed
        const botGuildIds = new Set(allBotServers.map(s => s.id));
        const userInBotGuild = userGuilds.some(g => botGuildIds.has(g.id));

        if (userInBotGuild) {
            return res.json({
                success: false,
                error: 'no_access',
                message: "You don't have access to any servers yet. Ask the server owner to grant dashboard access."
            });
        } else {
            return res.json({
                success: false,
                error: 'no_bot',
                message: "The bot isn't installed in any of your servers."
            });
        }
    }

    res.json({ success: true, servers: accessibleServers });
});

app.get('/api/user/active-bots', ensureAuthenticated, async (req, res) => {
    try {
        const userId = req.user.id; // This is Discord ID from Passport

        // console.log('🔍 DEBUG - Active Bots API:');
        // console.log('  - API userId (from Passport):', userId);
        // console.log('  - userId type:', typeof userId);

        // Filter bots for this user (removed spammy debug logs)
        const userBots = Array.from(activeBots.entries())
            .filter(([_, bot]) => bot.userId === userId)
            .map(([botId, bot]) => ({
                botId,
                serverData: bot.serverData,
                lastHeartbeat: bot.lastHeartbeat,
                online: Date.now() - bot.lastHeartbeat < 60000
            }));
        res.json(userBots);
    } catch (error) {
        console.error('❌ Active bots API error:', error);
        res.status(500).json({ message: 'Internal server error' });
    }
});


// Get server details with channels and roles
app.get('/api/server/:serverId/details', ensureAuthenticated, async (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;
    const userGuilds = req.session?.userGuilds || [];

    debugLogger.logApiRequest('GET', `/api/server/${serverId}/details`, { serverId, userId });

    // Find a bot that has this server and user has access
    const targetBot = findBotForServer(userId, serverId, userGuilds);

    if (!targetBot) {
        const response = { message: 'Server not found or bot offline' };
        debugLogger.logApiRequest('GET', `/api/server/${serverId}/details`, { serverId, userId }, { status: 404, ...response });
        return res.status(404).json(response);
    }

    // Request server details from bot
    const botSocket = io.sockets.sockets.get(targetBot.socketId);
    if (botSocket) {
        botSocket.emit('get_server_details', { serverId });

        debugLogger.logEvent('api', 'server_details_request', {
            serverId,
            userId,
            botSocket: targetBot.socketId
        });

        // Wait for response (implement timeout)
        const timeout = setTimeout(() => {
            const response = { message: 'Request timeout' };
            debugLogger.logApiRequest('GET', `/api/server/${serverId}/details`, { serverId, userId }, { status: 408, ...response });
            res.status(408).json(response);
        }, 10000);

        botSocket.once('server_details_response', (data) => {
            clearTimeout(timeout);
            if (data.serverId === serverId) {
                debugLogger.logApiRequest('GET', `/api/server/${serverId}/details`, { serverId, userId }, { status: 200, hasData: true });
                res.json(data);
            }
        });
    } else {
        const response = { message: 'Bot not available' };
        debugLogger.logApiRequest('GET', `/api/server/${serverId}/details`, { serverId, userId }, { status: 503, ...response });
        res.status(503).json(response);
    }
});
app.get('/api/server/:serverId/tickets', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;

    debugLogger.logApiRequest('GET', `/api/server/${serverId}/tickets`, { serverId, userId });

