        res.redirect(`${FRONTEND_URL}/dashboard`);
    });
});
app.get('/api/user', (req, res) => {
    // TESTING: Enable debug logs
    // console.log('\n🔍 ========== /api/user DEBUG ==========');
    // console.log('📝 Session ID:', req.sessionID);
