/* ------------------------------------------------------------------ */
// Get all verification configurations for user
app.get('/api/verification/all', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    const userConfigs = [];

    // Find all servers the user has access to
    for (const [serverId, config] of botVerificationConfigs) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            userConfigs.push({
                serverId,
                config
            });
        }
    }

    res.json({
        success: true,
        configs: userConfigs,
        count: userConfigs.length
    });
});

// Enable verification for multiple servers
app.post('/api/verification/bulk/enable', ensureAuthenticated, (req, res) => {
    const { serverIds, configData } = req.body;
    const userId = req.user.id;

    if (!Array.isArray(serverIds)) {
        return res.status(400).json({ success: false, message: 'serverIds must be an array' });
    }

    let successCount = 0;
    serverIds.forEach(serverId => {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            io.to(targetBot.socketId).emit('config_command', {
                command: 'enable_verification_system',
                serverId,
                payload: { configData: configData || {} },
                timestamp: Date.now()
            });
            successCount++;
        }
    });

    res.json({
        success: true,
        message: `Enable command sent to ${successCount} servers`,
        processed: successCount,
        total: serverIds.length
    });
});

// Disable verification for multiple servers
app.post('/api/verification/bulk/disable', ensureAuthenticated, (req, res) => {
    const { serverIds } = req.body;
    const userId = req.user.id;

    if (!Array.isArray(serverIds)) {
        return res.status(400).json({ success: false, message: 'serverIds must be an array' });
    }

    let successCount = 0;
    serverIds.forEach(serverId => {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            io.to(targetBot.socketId).emit('config_command', {
                command: 'disable_verification_system',
                serverId,
                payload: {},
                timestamp: Date.now()
            });
            successCount++;
        }
    });

    res.json({
        success: true,
        message: `Disable command sent to ${successCount} servers`,
        processed: successCount,
        total: serverIds.length
    });
});

/* ------------------------------------------------------------------ */
/*  VERIFICATION Analytics & Insights                                 */
/* ------------------------------------------------------------------ */
// Get verification analytics across all servers
app.get('/api/verification/analytics', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    const analytics = {
        totalServers: 0,
        enabledServers: 0,
        disabledServers: 0,
        totalVerifiedMembers: 0,
        totalUnverifiedMembers: 0,
        serversWithIssues: 0
    };

    // Calculate analytics from cached configs
    for (const [serverId, config] of botVerificationConfigs) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            analytics.totalServers++;
            if (config.verificationEnabled) {
                analytics.enabledServers++;
            } else {
                analytics.disabledServers++;
            }
        }
    }

    res.json({
        success: true,
        analytics
    });
});

// Get verification leaderboard (most verified members)
app.get('/api/verification/leaderboard', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    const leaderboard = [];

    for (const [serverId, config] of botVerificationConfigs) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot && config.verificationEnabled) {
            const serverData = targetBot.serverData.find(s => s.id === serverId);
            leaderboard.push({
                serverId,
                serverName: serverData?.name || 'Unknown',
                memberCount: serverData?.memberCount || 0,
                isEnabled: config.verificationEnabled
            });
        }
    }

    // Sort by member count
    leaderboard.sort((a, b) => b.memberCount - a.memberCount);

    res.json({
        success: true,
        leaderboard: leaderboard.slice(0, 10) // Top 10
    });
});
// Invite Tracker Management Routes
/* ------------------------------------------------------------------ */
/*  GET Invite Tracker Configuration                                 */
/* ------------------------------------------------------------------ */
app.get('/api/server/:serverId/invitetracker', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;

    debugLogger.logApiRequest('GET', `/api/server/${serverId}/invitetracker`, { serverId, userId });

    const config = botInviteTrackerConfigs.get(String(serverId)) || null;

    // Request fresh data if no config
    if (!config) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            console.log(`📡 Requesting fresh invite tracker config for server ${serverId}`);
            io.to(targetBot.socketId).emit('config_command', {
                command: 'get_invitetracker_config',
                serverId,
                payload: {},
                timestamp: Date.now()
            });
        }
    }

    res.json({ success: true, config });
});

/* ------------------------------------------------------------------ */
/*  SETUP Invite Tracker System                                      */
/* ------------------------------------------------------------------ */
app.post('/api/server/:serverId/invitetracker', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const { channelId, status } = req.body;

    if (!channelId) {
        return res.status(400).json({ success: false, message: 'channelId is required' });
    }

    const payload = {
        channelId,
        status: status !== undefined ? status : true
    };
    forwardCommand(req, res, serverId, 'setup_invitetracker', payload);
});

/* ------------------------------------------------------------------ */
/*  UPDATE Invite Tracker Configuration                              */
/* ------------------------------------------------------------------ */
app.put('/api/server/:serverId/invitetracker', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const payload = {
        updateData: req.body
    };
    forwardCommand(req, res, serverId, 'update_invitetracker', payload);
});

/* ------------------------------------------------------------------ */
/*  TOGGLE Invite Tracker Status                                     */
/* ------------------------------------------------------------------ */
app.patch('/api/server/:serverId/invitetracker/status', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const { status } = req.body;

    if (status !== undefined) {
        const payload = { updateData: { status } };
        forwardCommand(req, res, serverId, 'update_invitetracker', payload);
    } else {
        forwardCommand(req, res, serverId, 'toggle_invitetracker', {});
    }
});

