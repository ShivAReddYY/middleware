// Update auto-response settings
app.put('/api/server/:serverId/afk/user/:userId/auto-response', ensureAuthenticated, (req, res) => {
    const { serverId, userId } = req.params;
    const requestUserId = req.user.id;

    // Users can only update their own auto-response
    if (userId !== requestUserId) {
        return res.status(403).json({ success: false, message: 'Can only update your own auto-response' });
    }

    forwardCommand(req, res, serverId, 'update_auto_response', { userId, settings: req.body });
});

