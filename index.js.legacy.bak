// ════════════════ MEMBER SEARCH API ════════════════

// Search/Get server members for member selector UI
app.get('/api/server/:serverId/members', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const { query } = req.query;

    const targetBot = getAnyBotWithServer(serverId);

    if (!targetBot) {
        return res.status(404).json({ success: false, message: 'Bot not connected' });
    }

    const botSocket = io.sockets.sockets.get(targetBot.socketId);
    if (!botSocket) {
        return res.status(404).json({ success: false, message: 'Bot socket not found' });
    }

    // Use PendingRequests Map for member search too
    const requestId = `get_server_members_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;

    const timeout = setTimeout(() => {
        if (pendingRequests.has(requestId)) {
            pendingRequests.delete(requestId);
            res.json({ success: true, members: [] });
        }
    }, 10000);

    pendingRequests.set(requestId, {
        res,
        socketId: targetBot.socketId,
        serverId,
        expectedTypes: ['server_members'],
        timeout,
        command: 'get_server_members',
        createdAt: Date.now(),
        // Custom resolver for member search (returns members array instead of raw payload)
        customResolve: (payload) => {
            return { success: true, members: payload.members || [] };
        }
    });

    // Send command to bot
    io.to(targetBot.socketId).emit('config_command', {
        command: 'get_server_members',
        serverId,
        payload: { query: query || '' },
        requestId,
        timestamp: Date.now()
    });
});

// ════════════════ CUSTOM COMMANDS API (Server-Scoped) ════════════════

// Get server's custom commands
app.get('/api/server/:serverId/customcommands', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;

    const targetBot = getAnyBotWithServer(serverId);

    if (!targetBot) {
        return res.status(404).json({ success: false, message: 'Bot not connected' });
    }

    io.to(targetBot.socketId).emit('config_command', {
        command: 'get_server_customcommands',
        serverId,
        payload: {},
        timestamp: Date.now()
    });

    res.json({ success: true, message: 'Custom commands request sent' });
});

// Create/Update custom command (server-scoped)
app.post('/api/server/:serverId/customcommands', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const { userId: ownerId, commandName, response } = req.body;
    const dashboardUserId = req.user.id;

    if (!commandName || !response) {
        return res.status(400).json({ success: false, message: 'Command name and response are required' });
    }

    const targetBot = Array.from(activeBots.values()).find(bot =>
        bot.userId === dashboardUserId &&
        bot.serverData.some(s => s.id === serverId)
    );

    if (!targetBot) {
        return res.status(404).json({ success: false, message: 'Bot not connected' });
    }

    io.to(targetBot.socketId).emit('config_command', {
        command: 'create_customcommand',
        serverId,
        payload: { userId: ownerId || dashboardUserId, commandName, response },
        timestamp: Date.now()
    });

    res.json({ success: true, message: 'Custom command creation request sent' });
});

// Delete custom command (server-scoped)
app.delete('/api/server/:serverId/customcommands/:commandName', ensureAuthenticated, (req, res) => {
    const { serverId, commandName } = req.params;
    const userId = req.user.id;

    const targetBot = getAnyBotWithServer(serverId);

    if (!targetBot) {
        return res.status(404).json({ success: false, message: 'Bot not connected' });
    }

    io.to(targetBot.socketId).emit('config_command', {
        command: 'delete_customcommand',
        serverId,
        payload: { commandName, isAdmin: true },
        timestamp: Date.now()
    });

    res.json({ success: true, message: 'Custom command deletion request sent' });
});

