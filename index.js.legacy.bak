                const guildId = String(payload.guildId);
                if (payload.config) {
                    botRoleNickConfigs.set(guildId, payload.config);
                } else {
                    botRoleNickConfigs.delete(guildId);
                }

                io.to(`user_${botData.userId}`).emit('server_rolenick_updated', {
                    serverId: guildId,
                    config: payload.config
                });
                debugLogger.logEvent('socket', 'server_rolenick_received', {
                    serverId: guildId,
                    hasConfig: !!payload.config
                });
                break;
            }

            case 'rolenick_deleted': {
                const guildId = String(payload.guildId);
                botRoleNickConfigs.delete(guildId);

                io.to(`user_${botData.userId}`).emit('server_rolenick_deleted', {
                    serverId: guildId
                });
                debugLogger.logEvent('socket', 'rolenick_deleted', { serverId: guildId });
                break;
            }

            case 'rolenick_stats':
            case 'rolenick_error':
            case 'nickname_applied':
                io.to(`user_${botData.userId}`).emit(type, payload);
                debugLogger.logEvent('socket', type, payload);
                break;




            case 'aichat_config': {
                const guildId = String(payload.guildId);
                botAiChatConfigs.set(guildId, payload);

                io.to(`user_${botData.userId}`).emit('server_aichat_updated', {
                    serverId: guildId,
                    config: payload
                });
                debugLogger.logEvent('socket', 'aichat_config_received', {
                    serverId: guildId,
                    isEnabled: payload.isEnabled
                });
                break;
            }

            // Server AI chat config
            case 'server_aichat': {
                const guildId = String(payload.guildId);
                if (payload.config) {
