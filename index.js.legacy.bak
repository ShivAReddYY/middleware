    if (!guildData) {
        return res.status(404).json({
            success: false,
            error: 'Guild data not found'
        });
    }

    const dropdownData = {
        channels: guildData.channels.map(channel => ({
            id: channel.id,
            name: channel.name,
            type: channel.type,
            typeString: channel.typeString,
            parentName: channel.parentName
        })),
        categories: guildData.categories.map(category => ({
            id: category.id,
            name: category.name
        })),
        roles: guildData.roles
            .filter(role => !role.managed && !role.isEveryone)
            .map(role => ({
                id: role.id,
                name: role.name,
                color: role.color,
                hexColor: role.hexColor
            }))
    };

    res.json({
        success: true,
        data: dropdownData
    });
});
// Fix your refresh route:
app.post('/api/server/:serverId/refresh-data', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;

    // Clear cache
    botGuildData.delete(serverId);
    botChannelData.delete(serverId);
    botRoleData.delete(serverId);
    botServerStats.delete(serverId);

    // Find bot and request fresh data
    const targetBot = Array.from(activeBots.values()).find(bot =>
        bot.userId === req.user.id && // ❌ Wrong! Bots don't have user IDs
        bot.serverData.some(server => server.id === serverId)
    );
    if (targetBot) {
        io.to(targetBot.socketId).emit('config_command', {
            command: 'refresh_server_data',
            serverId,
            payload: {},
            timestamp: Date.now()
        });

        res.json({
            success: true,
            message: 'Refreshing server data from bot'
        });
    } else {
        res.status(503).json({
            success: false,
            error: 'No active bot found for this server'
        });
    }
});

// Add these helper functions to your middleware:

function getGuildCacheStats() {
    return {
        guildDataCount: botGuildData.size,
        channelDataCount: botChannelData.size,
        roleDataCount: botRoleData.size,
        serverStatsCount: botServerStats.size,
        totalMemoryUsage: process.memoryUsage()
    };
}

function clearGuildDataCache(serverId) {
    botGuildData.delete(serverId);
    botChannelData.delete(serverId);
    botRoleData.delete(serverId);
    botServerStats.delete(serverId);

    debugLogger.logEvent('GUILD_CACHE_CLEARED', `Server: ${serverId}`);
}

// Get cache statistics (admin only)
app.get('/api/admin/cache/guild-stats', ensureAuthenticated, (req, res) => {
    try {
        // Check if user is admin (implement your admin check)
        if (!req.user.isAdmin) {
            return res.status(403).json({
                success: false,
                error: 'Admin access required'
            });
        }

        const stats = getGuildCacheStats();

        res.json({
            success: true,
            stats: {
                ...stats,
                cacheAges: {
                    oldestGuildData: Math.min(...Array.from(botGuildData.values()).map(d =>
                        Date.now() - new Date(d.lastUpdated).getTime()
                    )),
                    newestGuildData: Math.max(...Array.from(botGuildData.values()).map(d =>
                        Date.now() - new Date(d.lastUpdated).getTime()
                    ))
                }
            }
        });
    } catch (error) {
        res.status(500).json({
            success: false,
            error: error.message
        });
    }
});

