const app = express();
const server = http.createServer(app);
const MONGODB_URI = process.env.API_KEYS_MONGODB_URI;
// ========== JSON DEBUG SYSTEM ==========
class DebugLogger {
    constructor() {
        this.debugData = {
            metadata: {
                serverStartTime: new Date().toISOString(),
                lastUpdated: new Date().toISOString(),
                version: "1.0.0"
            },
            server: {
                port: PORT,
                frontendUrl: FRONTEND_URL,
                nodeEnv: process.env.NODE_ENV || 'development',
                isProduction: process.env.NODE_ENV === 'production'
            },
            connections: {
                activeBots: {},
                userSessions: {},
                socketConnections: {}
            },
            database: {
                mongodb: {
                    connected: false,
                    connectionString: process.env.API_KEYS_MONGODB_URI ? '[REDACTED]' : 'not_set',
                    lastError: null
                },
                apiKeys: [],
                totalKeys: 0
            },
            discord: {
                clientId: process.env.DISCORD_CLIENT_ID || 'not_set',
                callbackUrl: process.env.DISCORD_CALLBACK_URL || `http://localhost:${PORT}/auth/discord/callback`,
                authSessions: []
            },
            realTimeEvents: [],
            apiRequests: [],
            errors: [],
            heartbeats: {},
            statistics: {
                totalConnections: 0,
                totalBotConnections: 0,
                totalUserConnections: 0,
                totalApiRequests: 0,
                totalErrors: 0
            }
        };

        // Save debug data every 5 seconds
        setInterval(() => {
            this.saveDebugData();
        }, 5000);
    }

    updateMetadata() {
        this.debugData.metadata.lastUpdated = new Date().toISOString();
    }

    logEvent(category, event, data = {}) {
        const eventLog = {
            timestamp: new Date().toISOString(),
            category,
            event,
            data: JSON.parse(JSON.stringify(data)) // Deep clone to avoid references
        };

        this.debugData.realTimeEvents.unshift(eventLog);

        // Keep only last 100 events
        if (this.debugData.realTimeEvents.length > 100) {
            this.debugData.realTimeEvents = this.debugData.realTimeEvents.slice(0, 100);
        }

        this.updateMetadata();
    }

    logApiRequest(method, url, params = {}, response = {}) {
        const requestLog = {
            timestamp: new Date().toISOString(),
            method,
            url,
            params,
            response: {
                status: response.status || 200,
                message: response.message || 'success'
            }
        };

        this.debugData.apiRequests.unshift(requestLog);
        this.debugData.statistics.totalApiRequests++;

        // Keep only last 50 requests
        if (this.debugData.apiRequests.length > 50) {
            this.debugData.apiRequests = this.debugData.apiRequests.slice(0, 50);
        }

        this.updateMetadata();
    }

    logError(error, context = '') {
        const errorLog = {
            timestamp: new Date().toISOString(),
            context,
            message: error.message,
            stack: error.stack,
            type: error.name || 'Error'
        };

        this.debugData.errors.unshift(errorLog);
        this.debugData.statistics.totalErrors++;

        // Keep only last 50 errors
        if (this.debugData.errors.length > 50) {
            this.debugData.errors = this.debugData.errors.slice(0, 50);
        }

        this.updateMetadata();
    }

    updateActiveBots(activeBots) {
        this.debugData.connections.activeBots = {};

        for (const [botId, bot] of activeBots) {
            this.debugData.connections.activeBots[botId] = {
                userId: bot.userId,
                socketId: bot.socketId,
                serverCount: bot.serverData?.length || 0,
                servers: bot.serverData || [],
                lastHeartbeat: new Date(bot.lastHeartbeat).toISOString(),
                authenticated: bot.authenticated,
                isOnline: Date.now() - bot.lastHeartbeat < 60000,
                connectionDuration: Date.now() - (bot.connectTime || Date.now())
            };
        }

        this.updateMetadata();
    }

    updateUserSessions(userSessions) {
        this.debugData.connections.userSessions = {};

        for (const [userId, session] of userSessions) {
            this.debugData.connections.userSessions[userId] = {
                socketId: session.socketId,
                isAuthenticated: session.isAuthenticated,
                connectTime: session.connectTime ? new Date(session.connectTime).toISOString() : null
            };
        }

        this.updateMetadata();
    }

    updateHeartbeat(botId, timestamp) {
        this.debugData.heartbeats[botId] = {
            lastHeartbeat: new Date(timestamp).toISOString(),
            isAlive: Date.now() - timestamp < 60000
        };

        this.updateMetadata();
    }

    updateStatistics(activeBots, userSessions) {
        this.debugData.statistics.totalConnections = activeBots.size + userSessions.size;
        this.debugData.statistics.totalBotConnections = activeBots.size;
        this.debugData.statistics.totalUserConnections = userSessions.size;

        this.updateMetadata();
    }

    saveDebugData() {
        try {
            const debugFilePath = path.join(__dirname, 'debug_data.json');
            fs.writeFileSync(debugFilePath, JSON.stringify(this.debugData, null, 2));
        } catch (error) {
            console.error('Failed to save debug data:', error);
        }
    }

    getDebugData() {
        return JSON.parse(JSON.stringify(this.debugData));
    }
}

// Initialize debug logger
const debugLogger = new DebugLogger();

// Socket.IO setup with CORS
const io = socketIo(server, {
    cors: {
        origin: FRONTEND_URL,
        methods: ["GET", "POST"],
        credentials: true
    }
});

// ════════════════════════════════════════════════════════════════════════════
// GENERIC CONFIG PROTOCOL — production-grade request/response lifecycle
// shared by every module (see lib/configProtocol.js). This is additive and
// runs alongside the legacy forwardCommand()/COMMAND_RESPONSE_MAP path, which
// remains untouched so unmigrated modules keep working exactly as before.
// ════════════════════════════════════════════════════════════════════════════
const configProtocol = new ConfigProtocol({ io, logger: console });

// Rate limiting
const limiter = rateLimit({
    windowMs: 15 * 60 * 1000, // 15 minutes
    max: 10000000, // limit each IP to 100 requests per windowMs
    message: 'Too many requests from this IP, please try again later.'
});


// CORS and JSON middleware
app.use(limiter);
app.use(cors({
    origin: FRONTEND_URL,
    credentials: true,
}));
app.use(express.json({ limit: '10mb' }));

app.set("trust proxy", 1); // VERY important for render/vercel/proxy setup
// Test MongoDB connection separately
async function testMongoConnection() {
    try {
        const client = new MongoClient(MONGODB_URI);
        await client.connect();
        await client.db().admin().ping();
        //console.log('✅ Direct MongoDB connection successful');
        await client.close();
    } catch (error) {
        console.error('❌ Direct MongoDB connection failed:', error.message);
    }
}
//console.log('🔗 MongoDB URI for sessions:', MONGODB_URI.replace(/\/\/[^:]+:[^@]+@/, '//***:***@'));

// Create session store with extensive debugging
const sessionStore = MongoStore.create({
    mongoUrl: MONGODB_URI,
    collectionName: 'sessions', // Explicit collection name
    ttl: 7 * 24 * 60 * 60, // 7 days in seconds
    touchAfter: 24 * 3600,
    stringify: false,
    autoRemove: 'native'
});

// Session store event listeners for debugging
sessionStore.on('create', (sessionId) => {
    //console.log('✅ Session CREATED:', sessionId);
});

sessionStore.on('update', (sessionId) => {
    //console.log('🔄 Session UPDATED:', sessionId);
});

sessionStore.on('touch', (sessionId) => {
    //console.log('👆 Session TOUCHED:', sessionId);
});

sessionStore.on('destroy', (sessionId) => {
    //console.log('🗑️ Session DESTROYED:', sessionId);
});

sessionStore.on('error', (error) => {
    //console.error('❌ Session Store ERROR:', error);
});
testMongoConnection();


// Session configuration with comprehensive debugging
// TESTING MODE: Cookie settings relaxed for localhost testing
const isProduction = process.env.NODE_ENV === 'production';
app.use(session({
    name: 'ssid',
    secret: process.env.SESSION_SECRET || 'super123-fallback-secret',
    resave: false,
    saveUninitialized: false,
    store: sessionStore,
    cookie: {
        httpOnly: true,
        // TESTING: secure disabled for localhost (HTTP)
        secure: isProduction, // Only use secure cookies in production
        // TESTING: sameSite relaxed for localhost
        sameSite: isProduction ? "none" : "lax", // Use "lax" for localhost, "none" for production
        // TESTING: domain commented out for localhost testing
        // domain: ".glaceyt.com", // Only set domain in production
        maxAge: 1000 * 60 * 60 * 24 * 7, // 7 days
    }
}));

// Initialize Passport
app.use(passport.initialize());
app.use(passport.session());

// Passport configuration
// FIXED Passport configuration
passport.serializeUser((user, done) => {
    //console.log(`✅ serializeUser: ${user.id} (${user.username})`);
    // Serialize the full user object for simplicity
    done(null, user);
});

passport.deserializeUser((userObj, done) => {
    //console.log(`🔄 deserializeUser for: ${userObj.id} (${userObj.username})`);

    try {
        // Return the full user object since we serialized it completely
        //console.log(`✅ deserializeUser SUCCESS: ${userObj.username}`);
        done(null, userObj);
    } catch (error) {
        //console.log(`❌ deserializeUser ERROR:`, error);
        done(error, null);
    }
});


const CLIENT_ID = process.env.DISCORD_CLIENT_ID;
const CLIENT_SECRET = process.env.DISCORD_CLIENT_SECRET;
const CALLBACK_URL = process.env.DISCORD_CALLBACK_URL || `http://localhost:${PORT}/auth/discord/callback`;

passport.use(new DiscordStrategy({
    clientID: CLIENT_ID,
    clientSecret: CLIENT_SECRET,
    callbackURL: CALLBACK_URL,
    scope: ['identify', 'guilds', 'guilds.join'],
}, (accessToken, refreshToken, profile, done) => {
    // Store access token for fetching user guilds later
    profile.accessToken = accessToken;

    debugLogger.logEvent('auth', 'discord_strategy_callback', {
        profileId: profile.id,
        username: profile.username,
        hasAccessToken: !!accessToken,
        hasRefreshToken: !!refreshToken
    });

    debugLogger.debugData.discord.authSessions.push({
        timestamp: new Date().toISOString(),
        userId: profile.id,
        username: profile.username,
        action: 'authenticated'
    });

    process.nextTick(() => done(null, profile));
}));
// In-memory stores for real-time data
const activeBots = new Map(); // botId -> { userId, socketId, serverData, lastHeartbeat }
const userSessions = new Map(); // userId -> { socketId, isAuthenticated }
const botGuildData = new Map();
const botChannelData = new Map();
const botRoleData = new Map();
const botServerStats = new Map();
const botApplicationConfigs = new Map(); // serverId -> config object
const botAutoResponderConfigs = new Map();
const botAutoVoiceConfigs = new Map(); // serverId -> autovoice config
const botTempVoiceChannels = new Map(); // serverId -> temporary channels[]
const botDisabledCommands = new Map();
const botRoleNickConfigs = new Map();
const botTicketConfigs = new Map();
const botAiChatConfigs = new Map(); // serverId -> AI chat config
const botEnabledAiChannels = new Map(); // global enabled channels list
const botVerificationConfigs = new Map();
const botServerConfigs = new Map(); // serverId -> server config
const botInviteTrackerConfigs = new Map();
const botQuarantineConfigs = new Map(); // guildId → QuarantineConfig payload
const botQuarantinedUsers = new Map(); // guildId → Array of UserQuarantine payloads
const botCustomCommands = new Map();
const botServerLogConfigs = new Map(); // serverId -> [log config objects]
const botServerLogStats = new Map(); // serverId -> stats object
const botWelcomeConfigs = new Map();
const botTruthOrDareConfigs = new Map();
const botLeaveConfigs = new Map();
const botSuggestionConfigs = new Map();
const botNqnConfigs = new Map();
const botAutoroleConfigs = new Map();
const botHentaiConfigs = new Map();
const botCommandLogsConfigs = new Map();
const botAFKData = new Map();
const botGiveawayData = new Map();
const botReactionRoleData = new Map();
const botGeminiData = new Map(); // serverId → { apiKeys: [], stats: {}, lastUpdated: 0 }
const botServerStatsData = new Map();

// Protection Systems Storage
const botLockRoles = new Map();         // guildId → lock role configs
const botRolePersistConfigs = new Map(); // guildId → role persist config
const botBoycottBans = new Map();       // guildId → boycott ban entries

// Anti-System V2 Storage
const botAntiConfigs = new Map();       // guildId → anti-system config
const botThreatScores = new Map();      // guildId → threat scores array
const botViolations = new Map();        // guildId → violations array

// New Module Storage
const botBirthdayConfigs = new Map();       // guildId → birthday config
const botBoostConfigs = new Map();          // serverId → boost config
const botCountingConfigs = new Map();       // serverId → counting config
const botFaqConfigs = new Map();            // guildId → faq config
const botLevelingConfigs = new Map();       // guildId → leveling config
const botModmailConfigs = new Map();        // guildId → modmail config
const botNotificationConfigs = new Map();   // guildId → notification configs array
const botRulesData = new Map();             // rules categories (global)
const botStickyMessageConfigs = new Map();  // serverId → sticky messages array
const botEmbedsData = new Map();            // serverId → { embeds: [], schedules: [] }

mongoose.connect(process.env.API_KEYS_MONGODB_URI)
    .then(() => {
        //console.log('✅ Connected to MongoDB.');
        debugLogger.debugData.database.mongodb.connected = true;
        debugLogger.logEvent('database', 'mongodb_connected', { uri: '[REDACTED]' });
    })
    .catch(err => {
        console.error('❌ MongoDB connection error:', err);
        debugLogger.debugData.database.mongodb.connected = false;
        debugLogger.debugData.database.mongodb.lastError = err.message;
        debugLogger.logError(err, 'MongoDB connection');
    });


const keySchema = new mongoose.Schema(
    {
        keyValue: {
            type: String,
            required: true,
            unique: true,
            index: true
        },
        userId: {
            type: String,
            required: true,
            index: true
        },
        discordId: {
            type: String,
            index: true
        },
        service: {
            type: String,
            required: true
        },
        isActive: {
            type: Boolean,
            default: true
        },
        createdAt: {
            type: Date,
            default: Date.now
        },
        lastUsedAt: {
            type: Date,
            default: null
        },
        description: {
            type: String,
            default: ''
        },
        botId: {
            type: String,
            default: null
        },
        _class: {
            type: String,
            default: 'com.ssrr.tech.AuthSystem.model.ApiKey'
        }
    },
    { collection: 'apikeys' }
);

const KeyModel = mongoose.model('ApiKey', keySchema);


const UserModel = mongoose.connection.collection('users');
io.on('connection', (socket) => {
    console.log(`Socket connected: ${socket.id}`);

    debugLogger.debugData.connections.socketConnections[socket.id] = {
        connectTime: new Date().toISOString(),
        type: 'unknown',
        userId: null,
        botId: null
    };

    debugLogger.logEvent('socket', 'connection', { socketId: socket.id });

    // Bot connection
    socket.on('bot_connect', async (data) => {
        const { botId, apiKey, userId: discordId } = data;

        console.log(`🔐 Bot connect attempt from botId: ${botId}, discordId: ${discordId}, socketId: ${socket.id}`);
        console.log(`🔎 Verifying API Key: ${apiKey}`);

        try {
            // 1. Find user _id by discordId
            const userDoc = await UserModel.findOne({ discordId });
            if (!userDoc) {
                console.warn(`❌ No user found with discordId: ${discordId}`);
                socket.emit('bot_auth_failed', { message: 'User not registered' });
                return;
            }

            const objectUserId = userDoc._id.toString(); // or keep as ObjectId if your apikeys use ObjectId

            // 2. Now find matching API key for that user _id
            const keyDoc = await KeyModel.findOne({
                userId: objectUserId, // this is the actual _id from users
                keyValue: apiKey,
                isActive: true
            });

            if (!keyDoc) {
                console.warn(`❌ Invalid API key for user ${objectUserId}`);
                socket.emit('bot_auth_failed', { message: 'Invalid API key' });
                return;
            }

            // ✅ Valid key — proceed
            keyDoc.isActive = true;
            keyDoc.botId = botId;
            keyDoc.lastUsedAt = new Date();
            await keyDoc.save();

            const botData = {
                userId: discordId, // ✅ Correct - using Discord ID from session/cookie
                mongoUserId: objectUserId, // Keep MongoDB ID as reference if needed
                socketId: socket.id,
                serverData: [],
                lastHeartbeat: Date.now(),
                authenticated: true,
                connectTime: Date.now()
            };

            activeBots.set(botId, botData);

            socket.botId = botId;
            socket.userId = objectUserId;
            socket.join(`bot_${botId}`);
            socket.join(`user_${objectUserId}`);

            debugLogger.debugData.connections.socketConnections[socket.id] = {
                connectTime: new Date().toISOString(),
                type: 'bot',
                userId: objectUserId,
                botId
            };

            socket.emit('bot_connected', { success: true });

            debugLogger.logEvent('socket', 'bot_connected', {
                botId,
                userId: objectUserId,
                socketId: socket.id
            });

            debugLogger.updateActiveBots(activeBots);
            debugLogger.updateStatistics(activeBots, userSessions);

            console.log(`🎉 Bot ${botId} connected successfully for user ${objectUserId}`);
        } catch (error) {
            console.error('❌ Bot connection error:', error);
            socket.emit('bot_auth_failed', { message: 'Connection failed' });
            debugLogger.logError(error, 'bot_connect');
        }
    });

    // Dashboard user connection
    socket.on('dashboard_connect', (data) => {
        const { userId } = data;
        console.log('🔍 Dashboard connecting with userId:', userId, 'vs bot userIds:', Array.from(activeBots.values()).map(b => b.userId));

        // Add this one line to see the comparison results:
        console.log('🔍 Bot matches for this user:', Array.from(activeBots.entries()).filter(([botId, bot]) => bot.userId === userId).length);
        if (userId) {
            const sessionData = {
                socketId: socket.id,
                isAuthenticated: true,
                connectTime: Date.now()
            };

            userSessions.set(userId, sessionData);
            socket.userId = userId;
            socket.join(`user_${userId}`);

            // Update debug connections
            debugLogger.debugData.connections.socketConnections[socket.id] = {
                connectTime: new Date().toISOString(),
                type: 'dashboard',
                userId,
                botId: null
            };

            debugLogger.logEvent('socket', 'dashboard_connect', {
                userId,
                socketId: socket.id
            });

            console.log(`Dashboard user ${userId} connected`);

            // Send confirmation first
            socket.emit('dashboard_connected', { success: true });

            // Then send all currently active bots with serverData
            // REPLACE the dashboard_connect setTimeout block with this enhanced version

            setTimeout(() => {
                let sentCount = 0;
                for (const [botId, bot] of activeBots.entries()) {
                    if (bot.userId === userId && bot.serverData?.length) {
                        // Send server data
                        socket.emit('server_data_updated', {
                            botId,
                            servers: bot.serverData
                        });
                        sentCount++;

                        debugLogger.logEvent('socket', 'server_data_sent', {
                            botId,
                            userId,
                            serverCount: bot.serverData.length
                        });

                        // Send application data for each server
                        bot.serverData.forEach(server => {
                            const serverApps = botApplicationConfigs.get(String(server.id)) || [];
                            if (serverApps.length > 0) {
                                socket.emit('server_applications_updated', {
                                    serverId: server.id,
                                    applications: serverApps
                                });

                                debugLogger.logEvent('socket', 'server_applications_sent', {
                                    serverId: server.id,
                                    userId,
                                    applicationCount: serverApps.length
                                });
                            }
                        });
                    }
                }

                debugLogger.updateUserSessions(userSessions);
                debugLogger.updateStatistics(activeBots, userSessions);

                console.log(`[Dashboard] Sent ${sentCount} bot data updates to user ${userId}`);
            }, 100);
        }
    });

    // Server room management — dashboard joins a server-specific room to receive live config updates
    socket.on('join_server_room', (data) => {
        const { serverId } = data;
        if (serverId && socket.userId) {
            socket.join(`server_${serverId}`);
            console.log(`📡 Dashboard user ${socket.userId} joined server room: ${serverId}`);
        }
    });

    socket.on('leave_server_room', (data) => {
        const { serverId } = data;
        if (serverId) {
            socket.leave(`server_${serverId}`);
        }
    });

    socket.on('bot_data_update', (data) => {
        const { type, payload } = data;
        const botData = activeBots.get(socket.botId);

        if (!botData) {
            debugLogger.logEvent('socket', 'bot_data_update_error', {
                botId: socket.botId,
                type,
                error: 'Bot data not found'
            });
            return;
        }

        debugLogger.logEvent('socket', 'bot_data_update', {
            botId: socket.botId,
            userId: botData.userId,
            type,
            payloadSize: JSON.stringify(payload).length
        });

        switch (type) {
            // SERVER DATA SYNC
            case 'servers':
                botData.serverData = payload;
                io.to(`user_${botData.userId}`).emit('server_data_updated', {
                    botId: socket.botId,
                    servers: payload
                });
                debugLogger.logEvent('socket', 'server_data_updated', {
                    botId: socket.botId,
                    userId: botData.userId,
                    serverCount: payload.length
                });
                debugLogger.updateActiveBots(activeBots);
                break;
            case 'guild_data':
                botGuildData.set(payload.serverId, {
                    serverId: payload.serverId,
                    name: payload.name,
                    icon: payload.icon,
                    memberCount: payload.memberCount,
                    channels: payload.channels,
                    roles: payload.roles,
                    categories: payload.categories,
                    owner: payload.owner,
                    lastUpdated: new Date(),
                    _id: payload._id
                });

                debugLogger.logEvent('GUILD_DATA_CACHED', `Server: ${payload.name} (${payload.serverId}) - ${payload.channels.length} channels, ${payload.roles.length} roles`);

                // Forward to connected dashboard users for this server
                socket.to(`server_${payload.serverId}`).emit('server_data_updated', {
                    type: 'guild_data',
                    data: payload
                });
                break;

            case 'server_channels':
                botChannelData.set(payload.serverId, {
                    serverId: payload.serverId,
                    channels: payload.channels,
                    categories: payload.categories,
                    lastUpdated: new Date()
                });

                debugLogger.logEvent('CHANNELS_CACHED', `Server: ${payload.serverId} - ${payload.channels.length} channels, ${payload.categories.length} categories`);

                socket.to(`server_${payload.serverId}`).emit('server_data_updated', {
                    type: 'server_channels',
                    data: payload
                });
                break;

            case 'server_roles':
                botRoleData.set(payload.serverId, {
                    serverId: payload.serverId,
                    roles: payload.roles,
                    lastUpdated: new Date()
                });

                debugLogger.logEvent('ROLES_CACHED', `Server: ${payload.serverId} - ${payload.roles.length} roles`);

                socket.to(`server_${payload.serverId}`).emit('server_data_updated', {
                    type: 'server_roles',
                    data: payload
                });
                break;

            case 'server_members':
                // Forward member search results to server room (all users viewing this server)
                io.to(`server_${payload.serverId}`).emit('server_members_data', {
                    serverId: payload.serverId,
                    query: payload.query || '',
                    members: payload.members || []
                });
                // Also send to bot owner for backward compatibility
                io.to(`user_${botData.userId}`).emit('server_members_data', {
                    serverId: payload.serverId,
                    query: payload.query || '',
                    members: payload.members || []
                });
                debugLogger.logEvent('MEMBERS_SEARCH', `Server: ${payload.serverId} - ${(payload.members || []).length} members found`);
                break;

            case 'server_customcommands':
                // Forward custom commands to server room (all users viewing this server)
                socket.to(`server_${payload.serverId}`).emit('server_data_updated', {
                    type: 'server_customcommands',
                    data: payload
                });
                io.to(`server_${payload.serverId}`).emit('server_customcommands_data', payload);
                // Also send to bot owner for backward compatibility
                io.to(`user_${botData.userId}`).emit('server_customcommands_data', payload);
                debugLogger.logEvent('CUSTOM_COMMANDS', `Server: ${payload.serverId} - ${(payload.commands || []).length} commands`);
                break;

            case 'server_stats':
                botServerStats.set(payload.serverId, {
                    serverId: payload.serverId,
                    name: payload.name,
                    memberCount: payload.memberCount,
                    channelCount: payload.channelCount,
                    textChannels: payload.textChannels,
                    voiceChannels: payload.voiceChannels,
                    categories: payload.categories,
                    roleCount: payload.roleCount,
                    boostLevel: payload.boostLevel,
                    boostCount: payload.boostCount,
                    createdAt: payload.createdAt,
                    features: payload.features,
                    lastUpdated: new Date()
                });

                debugLogger.logEvent('SERVER_STATS_CACHED', `Server: ${payload.name} (${payload.serverId})`);

                socket.to(`server_${payload.serverId}`).emit('server_data_updated', {
                    type: 'server_stats',
                    data: payload
                });
                break;

            case 'guild_data_error':
                debugLogger.logEvent('GUILD_DATA_ERROR', `Server: ${payload.serverId}, Error: ${payload.error}, Action: ${payload.action}`);

                socket.to(`server_${payload.serverId}`).emit('server_data_updated', {
                    type: 'guild_data_error',
                    data: payload
                });
                break;

            case 'ticket_config': {
                const srvId = String(payload.serverId);
                botTicketConfigs.set(srvId, payload);

                io.to(`user_${botData.userId}`).emit('server_ticket_updated', {
                    serverId: srvId,
                    config: payload
                });
                debugLogger.logEvent('socket', 'ticket_config_received', {
                    serverId: srvId,
                    status: payload.status
                });
                break;
            }

            // Handle server config from bot (for bot managers)
            case 'serverconfig_config': {
                const srvId = String(payload.serverId);
                botServerConfigs.set(srvId, {
                    serverId: srvId,
                    botManagers: payload.botManagers || [],
                    adminRoles: payload.adminRoles || [],
                    modRoles: payload.modRoles || [],
                    prefix: payload.prefix,
                    _id: payload._id,
                    resolvedManagers: payload.resolvedManagers,
                    resolvedAdminRoles: payload.resolvedAdminRoles,
                    resolvedModRoles: payload.resolvedModRoles,
                    lastUpdated: new Date()
                });

                console.log(`📋 Server config stored for ${srvId} - Bot Managers: ${(payload.botManagers || []).length}`);

                io.to(`user_${botData.userId}`).emit('server_serverconfig_updated', {
                    serverId: srvId,
                    config: payload
                });
                break;
            }

            case 'server_ticket_config': {
                const srvId = String(payload.serverId);
                if (payload.config) {
                    botTicketConfigs.set(srvId, payload.config);
                } else {
                    botTicketConfigs.delete(srvId);
                }

                io.to(`user_${botData.userId}`).emit('server_ticket_updated', {
                    serverId: srvId,
                    config: payload.config
                });
                debugLogger.logEvent('socket', 'server_ticket_received', {
                    serverId: srvId,
                    hasConfig: !!payload.config
                });
                break;
            }

            case 'ticket_deleted': {
                const srvId = String(payload.serverId);
                botTicketConfigs.delete(srvId);

                io.to(`user_${botData.userId}`).emit('server_ticket_deleted', {
                    serverId: srvId
                });
                debugLogger.logEvent('socket', 'ticket_deleted', { serverId: srvId });
                break;
            }

            case 'ticket_stats':
            case 'ticket_error':
                io.to(`user_${botData.userId}`).emit(type, payload);
                debugLogger.logEvent('socket', type, payload);
                break;

            // ADD THIS CASE to your bot_data_update switch statement in server.js
            case 'application_config':
                // Store application config
                const appServerId = String(payload.guildId);

                // Initialize server applications if not exists
                if (!botApplicationConfigs.has(appServerId)) {
                    botApplicationConfigs.set(appServerId, []);
                }

                // Get current applications for this server
                let serverApps = botApplicationConfigs.get(appServerId);

                // Update or add this application
                const existingIndex = serverApps.findIndex(app => app.appName === payload.appName);

                if (existingIndex >= 0) {
                    // Update existing
                    serverApps[existingIndex] = {
                        appName: payload.appName,
                        questions: payload.questions || [],
                        isActive: payload.isActive,
                        mainChannel: payload.mainChannel,
                        responseChannel: payload.responseChannel,
                        _id: payload._id
                    };
                } else {
                    // Add new
                    serverApps.push({
                        appName: payload.appName,
                        questions: payload.questions || [],
                        isActive: payload.isActive,
                        mainChannel: payload.mainChannel,
                        responseChannel: payload.responseChannel,
                        _id: payload._id
                    });
                }

                // Save back to map
                botApplicationConfigs.set(appServerId, serverApps);

                // Send to dashboard
                io.to(`user_${botData.userId}`).emit('application_config_updated', {
                    serverId: appServerId,
                    application: {
                        appName: payload.appName,
                        questions: payload.questions || [],
                        isActive: payload.isActive,
                        mainChannel: payload.mainChannel,
                        responseChannel: payload.responseChannel,
                        _id: payload._id
                    }
                });

                debugLogger.logEvent('socket', 'application_config_received', {
                    serverId: appServerId,
                    appName: payload.appName,
                    botId: socket.botId,
                    userId: botData.userId
                });
                break;

            // ADD THIS CASE to your bot_data_update switch statement in server.js
            case 'application_deleted':
                const delServerId = String(payload.guildId);

                // Remove from server applications
                if (botApplicationConfigs.has(delServerId)) {
                    let serverApps = botApplicationConfigs.get(delServerId);
                    serverApps = serverApps.filter(app => app.appName !== payload.appName);
                    botApplicationConfigs.set(delServerId, serverApps);
                }

                // Send to dashboard
                io.to(`user_${botData.userId}`).emit('application_deleted', {
                    serverId: delServerId,
                    appName: payload.appName,
                    _id: payload._id
                });

                debugLogger.logEvent('socket', 'application_deleted', {
                    serverId: delServerId,
                    appName: payload.appName,
                    botId: socket.botId,
                    userId: botData.userId
                });
                break;

            // ADD THIS CASE to your bot_data_update switch statement in server.js
            case 'server_applications':
                const serverAppId = String(payload.guildId);

                // Store all applications for this server
                botApplicationConfigs.set(serverAppId, payload.applications || []);

                // Send to dashboard
                io.to(`user_${botData.userId}`).emit('server_applications_updated', {
                    serverId: serverAppId,
                    applications: payload.applications || []
                });

                debugLogger.logEvent('socket', 'server_applications_received', {
                    serverId: serverAppId,
                    applicationCount: payload.applications?.length || 0,
                    botId: socket.botId,
                    userId: botData.userId
                });
                break;

            // ADD THIS CASE to your bot_data_update switch statement in server.js
            case 'application_error':
                // Send error to dashboard
                io.to(`user_${botData.userId}`).emit('application_error', {
                    serverId: payload.guildId,
                    error: payload.error,
                    action: payload.action
                });

                debugLogger.logEvent('socket', 'application_error', {
                    serverId: payload.guildId,
                    error: payload.error,
                    action: payload.action,
                    botId: socket.botId,
                    userId: botData.userId
                });
                break;

            // ADD THIS CASE to your bot_data_update switch statement in server.js
            case 'application_system_disabled':
                const disabledServerId = String(payload.guildId);

                // Mark all applications as inactive
                if (botApplicationConfigs.has(disabledServerId)) {
                    let serverApps = botApplicationConfigs.get(disabledServerId);
                    serverApps = serverApps.map(app => ({ ...app, isActive: false }));
                    botApplicationConfigs.set(disabledServerId, serverApps);
                }

                // Send to dashboard
                io.to(`user_${botData.userId}`).emit('application_system_disabled', {
                    serverId: disabledServerId,
                    disabledCount: payload.disabledCount
                });

                debugLogger.logEvent('socket', 'application_system_disabled', {
                    serverId: disabledServerId,
                    disabledCount: payload.disabledCount,
                    botId: socket.botId,
                    userId: botData.userId
                });
                break;

            case 'autoresponder_config': {
                const srvId = String(payload.guildId);

                if (!botAutoResponderConfigs.has(srvId))
                    botAutoResponderConfigs.set(srvId, []);

                const arr = botAutoResponderConfigs.get(srvId);
                const i = arr.findIndex(r => r._id === payload._id);
                (i >= 0) ? arr[i] = payload : arr.push(payload);

                botAutoResponderConfigs.set(srvId, arr);

                io.to(`user_${botData.userId}`)
                    .emit('autoresponder_config_updated', { serverId: srvId, autoresponder: payload });
                debugLogger.logEvent('socket', 'autoresponder_config_received', { serverId: srvId, trigger: payload.trigger });
                break;
            }

            // >>> AUTORESPONDER : BULK SEND
            case 'server_autoresponders': {
                const srvId = String(payload.guildId);
                botAutoResponderConfigs.set(srvId, payload.autoResponders || []);
                io.to(`user_${botData.userId}`)
                    .emit('server_autoresponders_updated', { serverId: srvId, autoresponders: payload.autoResponders || [] });
                debugLogger.logEvent('socket', 'server_autoresponders_received', { serverId: srvId, count: payload.autoResponders?.length || 0 });
                break;
            }

            // >>> AUTORESPONDER : DELETE
            case 'autoresponder_deleted': {
                const srvId = String(payload.guildId);
                if (botAutoResponderConfigs.has(srvId)) {
                    let arr = botAutoResponderConfigs.get(srvId)
                        .filter(r => r._id !== payload._id);
                    botAutoResponderConfigs.set(srvId, arr);
                }
                io.to(`user_${botData.userId}`)
                    .emit('autoresponder_deleted', { serverId: srvId, _id: payload._id, trigger: payload.trigger });
                debugLogger.logEvent('socket', 'autoresponder_deleted', { serverId: srvId, trigger: payload.trigger });
                break;
            }

            // >>> AUTORESPONDER : SYSTEM DISABLE
            case 'autoresponder_system_disabled': {
                const srvId = String(payload.guildId);
                if (botAutoResponderConfigs.has(srvId)) {
                    const arr = botAutoResponderConfigs.get(srvId)
                        .map(r => ({ ...r, status: false }));
                    botAutoResponderConfigs.set(srvId, arr);
                }
                io.to(`user_${botData.userId}`)
                    .emit('autoresponder_system_disabled', { serverId: srvId, disabledCount: payload.disabledCount });
                debugLogger.logEvent('socket', 'autoresponder_system_disabled', { serverId: srvId, disabled: payload.disabledCount });
                break;
            }

            // >>> AUTORESPONDER : ERROR
            case 'autoresponder_error':
                io.to(`user_${botData.userId}`)
                    .emit('autoresponder_error', payload);
                debugLogger.logEvent('socket', 'autoresponder_error', payload);
                break;


            // Add these cases to your existing bot_data_update switch statement

            // AutoVoice configuration
            case 'autovoice_config': {
                const cfg = payload;
                botAutoVoiceConfigs.set(cfg.guildId, cfg);
                io.to(`user_${botData.userId}`).emit('server_autovoice_updated', {
                    serverId: cfg.guildId,
                    autovoice: cfg
                });
                debugLogger.logEvent('socket', 'autovoice_config_received', {
                    serverId: cfg.guildId,
                    status: cfg.status
                });
                break;
            }

            // AutoVoice deleted
            case 'autovoice_deleted': {
                const srvId = String(payload.guildId);
                botAutoVoiceConfigs.delete(srvId);
                botTempVoiceChannels.delete(srvId);
                io.to(`user_${botData.userId}`).emit('server_autovoice_deleted', {
                    serverId: srvId
                });
                debugLogger.logEvent('socket', 'autovoice_deleted', { serverId: srvId });
                break;
            }

            // Temporary channels
            case 'temporary_channels': {
                const srvId = String(payload.guildId);
                botTempVoiceChannels.set(srvId, payload.channels || []);
                io.to(`user_${botData.userId}`).emit('temp_channels_updated', payload);
                debugLogger.logEvent('socket', 'temporary_channels_received', {
                    serverId: srvId,
                    count: payload.channels?.length || 0
                });
                break;
            }

            // Temporary channel deleted
            case 'temporary_channel_deleted': {
                const srvId = String(payload.guildId);
                if (botTempVoiceChannels.has(srvId)) {
                    const channels = botTempVoiceChannels.get(srvId)
                        .filter(c => c.channelId !== payload.channelId);
                    botTempVoiceChannels.set(srvId, channels);
                }
                io.to(`user_${botData.userId}`).emit('temp_channel_deleted', payload);
                debugLogger.logEvent('socket', 'temp_channel_deleted', {
                    serverId: srvId,
                    channelId: payload.channelId
                });
                break;
            }

            // AutoVoice stats, errors, and other events
            case 'autovoice_stats':
            case 'autovoice_error':
            case 'control_panel_refreshed':
            case 'temporary_channels_cleaned':
                io.to(`user_${botData.userId}`).emit(type, payload);
                debugLogger.logEvent('socket', type, payload);
                break;

            // Add these cases to your middleware handleConfigUpdate function
            // Add these cases to your middleware bot_data_update switch statement

            // Command configuration
            case 'command_config': {
                const guildId = String(payload.guildId);
                if (!botDisabledCommands.has(guildId)) {
                    botDisabledCommands.set(guildId, []);
                }
                const commands = botDisabledCommands.get(guildId);
                commands.push(payload);
                botDisabledCommands.set(guildId, commands);

                io.to(`user_${botData.userId}`).emit('command_disabled', {
                    serverId: guildId,
                    command: payload
                });
                debugLogger.logEvent('socket', 'command_disabled', {
                    serverId: guildId,
                    command: payload.commandName
                });
                break;
            }

            // Server disabled commands
            case 'server_disabled_commands': {
                const guildId = String(payload.guildId);
                botDisabledCommands.set(guildId, payload.commands || []);

                io.to(`user_${botData.userId}`).emit('server_disabled_commands_updated', {
                    serverId: guildId,
                    commands: payload.commands || []
                });
                debugLogger.logEvent('socket', 'server_disabled_commands_received', {
                    serverId: guildId,
                    count: payload.commands?.length || 0
                });
                break;
            }

            // Command enabled
            case 'command_enabled': {
                const guildId = String(payload.guildId);
                if (botDisabledCommands.has(guildId)) {
                    const commands = botDisabledCommands.get(guildId)
                        .filter(cmd => cmd._id !== payload._id);
                    botDisabledCommands.set(guildId, commands);
                }

                io.to(`user_${botData.userId}`).emit('command_enabled', {
                    serverId: guildId,
                    command: payload
                });
                debugLogger.logEvent('socket', 'command_enabled', {
                    serverId: guildId,
                    command: payload.commandName
                });
                break;
            }

            // All commands enabled
            case 'all_commands_enabled': {
                const guildId = String(payload.guildId);
                botDisabledCommands.set(guildId, []);

                io.to(`user_${botData.userId}`).emit('all_commands_enabled', {
                    serverId: guildId,
                    enabledCount: payload.enabledCount
                });
                debugLogger.logEvent('socket', 'all_commands_enabled', {
                    serverId: guildId,
                    count: payload.enabledCount
                });
                break;
            }

            // Command stats and errors
            case 'command_stats':
            case 'command_error':
                io.to(`user_${botData.userId}`).emit(type, payload);
                debugLogger.logEvent('socket', type, payload);
                break;

            //////////ROLE NICKNAME /////////

            case 'rolenick_config': {
                const guildId = String(payload.guildId);
                botRoleNickConfigs.set(guildId, payload);

                io.to(`user_${botData.userId}`).emit('server_rolenick_updated', {
                    serverId: guildId,
                    config: payload
                });
                debugLogger.logEvent('socket', 'rolenick_config_received', {
                    serverId: guildId,
                    roleCount: payload.roles?.length || 0
                });
                break;
