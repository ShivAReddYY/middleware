/* ------------------------------------------------------------------ */
/*  GET Custom Command Analytics                                     */
/* ------------------------------------------------------------------ */
app.get('/api/customcommands/analytics', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;

    const analytics = {
        totalUsers: 0,
        totalCommands: 0,
        averageCommandsPerUser: 0,
        mostActiveUsers: [],
        popularCommandNames: []
    };

    // Calculate analytics from cached commands
    const commandNameCounts = new Map();
    const userCommandCounts = [];

    for (const [commandUserId, commands] of botCustomCommands) {
        if (commands.length > 0) {
            analytics.totalUsers++;
            analytics.totalCommands += commands.length;

            userCommandCounts.push({
                userId: commandUserId,
                commandCount: commands.length
            });

            // Count command name frequency
            commands.forEach(cmd => {
                const count = commandNameCounts.get(cmd.commandName) || 0;
                commandNameCounts.set(cmd.commandName, count + 1);
            });
        }
    }

    analytics.averageCommandsPerUser = analytics.totalUsers > 0 ?
        Math.round((analytics.totalCommands / analytics.totalUsers) * 100) / 100 : 0;

    // Get most active users (top 5)
    analytics.mostActiveUsers = userCommandCounts
        .sort((a, b) => b.commandCount - a.commandCount)
        .slice(0, 5);

    // Get popular command names (top 10)
    analytics.popularCommandNames = Array.from(commandNameCounts.entries())
        .sort((a, b) => b[1] - a[1])
        .slice(0, 10)
        .map(([name, count]) => ({ name, count }));

    res.json({
        success: true,
        analytics
    });
});

