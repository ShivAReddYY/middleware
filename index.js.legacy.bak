/*  QUICK SETUP for Specific Server                                 */
/* ------------------------------------------------------------------ */
app.post('/api/server/:serverId/serverlogs/quick-setup', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const { channelId, events } = req.body;

    if (!channelId) {
        return res.status(400).json({ success: false, message: 'channelId is required' });
    }

    // Validate channel ID format
    if (!/^\d{17,19}$/.test(channelId)) {
        return res.status(400).json({ success: false, message: 'Invalid channel ID format' });
    }

    const userId = req.user.id;
    const targetBot = getAnyBotWithServer(serverId);

    if (!targetBot) {
        return res.status(404).json({ success: false, message: 'Server not found' });
    }

    if (events && Array.isArray(events) && events.length > 0) {
        // Setup specific events
        events.forEach(eventType => {
            io.to(targetBot.socketId).emit('config_command', {
                command: 'setup_event_logging',
                serverId,
                payload: { eventType, channelId },
                timestamp: Date.now()
            });
        });

        res.json({
            success: true,
            message: `Quick setup initiated for ${events.length} events`,
            events,
            channelId
        });
    } else {
        // Setup all events
        io.to(targetBot.socketId).emit('config_command', {
            command: 'setup_all_events_logging',
            serverId,
            payload: { channelId },
            timestamp: Date.now()
        });

        res.json({
            success: true,
            message: 'Quick setup initiated for all events',
            channelId
        });
    }
});
