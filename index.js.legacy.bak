                botServerConfigs.delete(srvId);

                io.to(`user_${botData.userId}`).emit('server_config_deleted', {
                    serverId: srvId
                });
                debugLogger.logEvent('socket', 'serverconfig_deleted', { serverId: srvId });
                break;
