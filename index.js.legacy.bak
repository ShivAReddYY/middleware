// Get invite tracker analytics across all servers
app.get('/api/invitetracker/analytics', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    const analytics = {
        totalServers: 0,
        enabledServers: 0,
        disabledServers: 0,
        serversWithChannels: 0,
        totalInvites: 0
    };

    // Calculate analytics from cached configs
    for (const [serverId, config] of botInviteTrackerConfigs) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            analytics.totalServers++;
            if (config.status) {
                analytics.enabledServers++;
            } else {
                analytics.disabledServers++;
            }
            if (config.inviteLogChannelId) {
                analytics.serversWithChannels++;
            }
        }
    }

    res.json({
        success: true,
        analytics
    });
});

// Get invite tracking leaderboard
app.get('/api/invitetracker/leaderboard', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    const leaderboard = [];

    for (const [serverId, config] of botInviteTrackerConfigs) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot && config.status) {
            const serverData = targetBot.serverData.find(s => s.id === serverId);
            leaderboard.push({
                serverId,
                serverName: serverData?.name || 'Unknown',
                memberCount: serverData?.memberCount || 0,
                isEnabled: config.status,
                hasChannel: !!config.inviteLogChannelId
            });
        }
    }

    // Sort by member count
    leaderboard.sort((a, b) => b.memberCount - a.memberCount);

    res.json({
        success: true,
        leaderboard: leaderboard.slice(0, 10) // Top 10
    });
});
