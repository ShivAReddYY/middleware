                    });
                }

                debugLogger.logEvent('socket', 'serverstats_data_received', {
                    guildId,
                    success: data?.success || false
                });
                break;
            }

            case 'serverstats_update': {
                if (!payload || !payload.guildId) break;

                const { guildId, data } = payload;
                if (data) {
                    const existing = botServerStatsData.get(guildId) || {};
                    botServerStatsData.set(guildId, {
                        ...existing,
                        ...data,
                        lastUpdated: Date.now()
                    });

                    console.log(`📊 Server stats updated for guild ${guildId}`);

                    io.to(`user_${botData.userId}`).emit('server_data_updated', {
                        serverId: guildId,
                        feature: 'serverstats',
                        data: data
                    });
                }
                break;
            }

            case 'heartbeat':
                botData.lastHeartbeat = Date.now();
                debugLogger.updateHeartbeat(socket.botId, botData.lastHeartbeat);
                debugLogger.updateActiveBots(activeBots);
                break;

            // ═══════ BIRTHDAY SYSTEM ═══════
            case 'server_birthday_config':
            case 'birthday_config': {
                if (!payload || (!payload.serverId && !payload.config?.guildId)) break;
                const srvId = String(payload.serverId || payload.config?.guildId);
                if (payload.config) {
                    botBirthdayConfigs.set(srvId, payload.config);
                } else {
                    botBirthdayConfigs.delete(srvId);
                }
                io.to(`user_${botData.userId}`).emit('server_birthday_updated', { serverId: srvId, config: payload.config });
                break;
            }
            case 'birthday_deleted': {
                if (!payload || !payload.serverId) break;
                botBirthdayConfigs.delete(String(payload.serverId));
                io.to(`user_${botData.userId}`).emit('server_birthday_deleted', { serverId: payload.serverId });
                break;
            }
            case 'birthday_upcoming': {
                if (!payload || !payload.serverId) break;
                io.to(`user_${botData.userId}`).emit('birthday_upcoming', payload);
                break;
            }
            case 'birthday_error':
                io.to(`user_${botData.userId}`).emit('birthday_error', payload);
                break;

            // ═══════ BOOST SYSTEM ═══════
            case 'server_boost_config':
            case 'boost_config': {
                if (!payload || (!payload.serverId && !payload.config?.serverId)) break;
                const srvId = String(payload.serverId || payload.config?.serverId);
                if (payload.config) {
                    botBoostConfigs.set(srvId, payload.config);
                } else {
                    botBoostConfigs.delete(srvId);
