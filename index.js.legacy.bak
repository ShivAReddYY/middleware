// Get server giveaways
app.get('/api/server/:serverId/giveaways', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;
    const { page = 1, limit = 10, status = null } = req.query;

    debugLogger.logApiRequest('GET', `/api/server/${serverId}/giveaways`, { serverId, userId });

    const serverData = botGiveawayData.get(String(serverId));
    let giveaways = serverData?.giveaways || [];

    // Filter by status if specified
    if (status && status !== 'all') {
        giveaways = giveaways.filter(g => g.status === status);
    }

    // Pagination
    const startIndex = (parseInt(page) - 1) * parseInt(limit);
    const paginatedGiveaways = giveaways.slice(startIndex, startIndex + parseInt(limit));

    const pagination = {
        current: parseInt(page),
        total: Math.ceil(giveaways.length / parseInt(limit)),
        hasNext: startIndex + parseInt(limit) < giveaways.length,
        hasPrev: parseInt(page) > 1,
        totalItems: giveaways.length
    };

    console.log(`🔍 Giveaway list API called for server ${serverId}, found ${giveaways.length} giveaways`);

    // Request fresh data if no server data
    if (!serverData) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            console.log(`📡 Requesting fresh giveaway list for server ${serverId}`);
            io.to(targetBot.socketId).emit('config_command', {
                command: 'get_server_giveaways',
                serverId,
                payload: { options: { page: parseInt(page), limit: parseInt(limit), status } },
                timestamp: Date.now()
            });
        }
    }

    res.json({ success: true, giveaways: paginatedGiveaways, pagination });
});

// Get single giveaway
