// Get all server configurations for user
app.get('/api/serverconfig/all', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    const userConfigs = [];

    // Find all servers the user has access to
    for (const [serverId, config] of botServerConfigs) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            userConfigs.push({
                serverId,
                config
            });
        }
    }

    res.json({
        success: true,
        configs: userConfigs,
        count: userConfigs.length
    });
});

