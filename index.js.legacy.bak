// Updated GET route - don't spam bot on every request
app.get('/api/server/:serverId/autoresponders', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;

    debugLogger.logApiRequest('GET', `/api/server/${serverId}/autoresponders`, { serverId, userId });

    const list = botAutoResponderConfigs.get(String(serverId)) || [];

    // Only request fresh data from bot if we have no cached data
    if (list.length === 0) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            console.log(`📡 Requesting fresh autoresponder data for server ${serverId}`);
            io.to(targetBot.socketId).emit('config_command', {
                command: 'get_server_autoresponders',
                serverId,
                payload: {},
                timestamp: Date.now()
            });
        }
    }

    res.json({ autoresponders: list });
});

