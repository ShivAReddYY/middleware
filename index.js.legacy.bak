/*  GET Server Logging Summary for Specific Server                  */
/* ------------------------------------------------------------------ */
app.get('/api/server/:serverId/serverlogs/summary', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;

    const logConfigs = botServerLogConfigs.get(String(serverId)) || [];
    const stats = botServerLogStats.get(String(serverId)) || null;

    const summary = {
        serverId,
        hasConfiguration: logConfigs.length > 0,
        configuredEvents: logConfigs.length,
        totalEvents: 16, // Total available event types
        coveragePercentage: Math.round((logConfigs.length / 16) * 100),
        uniqueChannels: [...new Set(logConfigs.map(config => config.channelId))].length,
        lastUpdated: logConfigs.length > 0 ?
            Math.max(...logConfigs.map(config => new Date(config.updatedAt).getTime())) : null,
        stats
    };

    res.json({ success: true, summary });
});

