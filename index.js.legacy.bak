// Activate/Deactivate application
app.patch('/api/server/:serverId/applications/:appName/status', ensureAuthenticated, (req, res) => {
    const { serverId, appName } = req.params;
    const userId = req.user.id;
    const { isActive } = req.body;

    debugLogger.logApiRequest('PATCH', `/api/server/${serverId}/applications/${appName}/status`, {
        serverId, userId, appName, isActive
    });

    // Find target bot
    const targetBot = getAnyBotWithServer(serverId);

    if (!targetBot) {
        const response = { message: 'Server not found or bot offline' };
        debugLogger.logApiRequest('PATCH', `/api/server/${serverId}/applications/${appName}/status`, req.body, { status: 404, ...response });
        return res.status(404).json(response);
    }

    // Send command to bot
    const botSocket = io.sockets.sockets.get(targetBot.socketId);
    if (botSocket) {
        const command = isActive ? 'activate_application' : 'deactivate_application';

        botSocket.emit('config_command', {
            command,
            serverId,
            payload: { appName },
            timestamp: Date.now()
        });

        const response = { success: true, message: `Application ${isActive ? 'activation' : 'deactivation'} request sent` };
        debugLogger.logApiRequest('PATCH', `/api/server/${serverId}/applications/${appName}/status`, req.body, { status: 200, ...response });
        res.json(response);
    } else {
        const response = { message: 'Bot not available' };
        debugLogger.logApiRequest('PATCH', `/api/server/${serverId}/applications/${appName}/status`, req.body, { status: 503, ...response });
        res.status(503).json(response);
    }
});

// Add question to application
app.post('/api/server/:serverId/applications/:appName/questions', ensureAuthenticated, (req, res) => {
    const { serverId, appName } = req.params;
    const userId = req.user.id;
    const { questionText, placeholder, inputType, required } = req.body;

    debugLogger.logApiRequest('POST', `/api/server/${serverId}/applications/${appName}/questions`, {
        serverId, userId, appName, questionText, inputType
    });

    if (!questionText) {
        const response = { message: 'Question text is required' };
        debugLogger.logApiRequest('POST', `/api/server/${serverId}/applications/${appName}/questions`, req.body, { status: 400, ...response });
        return res.status(400).json(response);
    }

    // Find target bot
    const targetBot = getAnyBotWithServer(serverId);

    if (!targetBot) {
        const response = { message: 'Server not found or bot offline' };
        debugLogger.logApiRequest('POST', `/api/server/${serverId}/applications/${appName}/questions`, req.body, { status: 404, ...response });
        return res.status(404).json(response);
    }

    // Send command to bot with new fields
    const botSocket = io.sockets.sockets.get(targetBot.socketId);
    if (botSocket) {
        botSocket.emit('config_command', {
            command: 'add_application_question',
            serverId,
            payload: {
                appName,
                questionText: questionText.substring(0, 45), // Discord label limit
                placeholder: placeholder ? placeholder.substring(0, 100) : '', // Discord placeholder limit
                inputType: inputType || 'PARAGRAPH', // SHORT or PARAGRAPH
                required: required !== false
            },
            timestamp: Date.now()
        });

        const response = { success: true, message: 'Question addition request sent' };
        debugLogger.logApiRequest('POST', `/api/server/${serverId}/applications/${appName}/questions`, req.body, { status: 200, ...response });
        res.json(response);
    } else {
        const response = { message: 'Bot not available' };
        debugLogger.logApiRequest('POST', `/api/server/${serverId}/applications/${appName}/questions`, req.body, { status: 503, ...response });
        res.status(503).json(response);
    }
});

