// ════════════════ PROTECTION SYSTEM API ════════════════

// Get Lock Roles
app.get('/api/server/:serverId/protection/lock-roles', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;

    const lockRolesData = botLockRoles.get(String(serverId));
    if (lockRolesData) {
        return res.json({ success: true, ...lockRolesData });
    }

    const targetBot = Array.from(activeBots.values()).find(bot => bot.userId === userId);
    if (targetBot) {
        io.to(targetBot.socketId).emit('config_command', {
            command: 'get_lock_roles',
            serverId,
            payload: {},
            timestamp: Date.now()
        });
    }

    res.json({ success: true, guildId: serverId, enabled: false, roles: [] });
});

// Add Lock Role
app.post('/api/server/:serverId/protection/lock-roles', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;
    const { roleId } = req.body;

    const targetBot = Array.from(activeBots.values()).find(bot => bot.userId === userId);
    if (!targetBot) {
        return res.status(404).json({ success: false, message: 'Bot not connected' });
    }

    io.to(targetBot.socketId).emit('config_command', {
        command: 'add_lock_role',
        serverId,
        payload: { roleId, addedBy: userId },
        timestamp: Date.now()
    });

    res.json({ success: true, message: 'Request sent to bot' });
});

// Remove Lock Role
app.delete('/api/server/:serverId/protection/lock-roles/:roleId', ensureAuthenticated, (req, res) => {
    const { serverId, roleId } = req.params;
    const userId = req.user.id;

    const targetBot = Array.from(activeBots.values()).find(bot => bot.userId === userId);
    if (!targetBot) {
        return res.status(404).json({ success: false, message: 'Bot not connected' });
    }

    io.to(targetBot.socketId).emit('config_command', {
        command: 'remove_lock_role',
        serverId,
        payload: { roleId },
        timestamp: Date.now()
    });

    res.json({ success: true, message: 'Request sent to bot' });
});

