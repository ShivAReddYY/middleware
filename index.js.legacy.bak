                bot.userId === req.user.id &&
                bot.serverData.some(server => server.id === serverId)
            );

            if (targetBot) {
                io.to(targetBot.socketId).emit('config_command', {
                    command: 'get_server_details',
                    serverId,
                    payload: {},
                    timestamp: Date.now()
                });

                return res.json({
                    success: true,
                    message: 'Requesting fresh data from bot'
                });
