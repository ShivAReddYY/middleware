    }

    const targetBot = Array.from(activeBots.values()).find(bot => bot.userId === userId);
    if (targetBot) {
        io.to(targetBot.socketId).emit('config_command', {
            command: 'get_boycott_bans',
            serverId,
            payload: {},
            timestamp: Date.now()
        });
    }

    res.json({ success: true, guildId: serverId, bans: [] });
});

// Add Boycott Ban
app.post('/api/server/:serverId/protection/boycott-bans', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;
    const { targetUserId, protectedRoles, reason } = req.body;

    const targetBot = Array.from(activeBots.values()).find(bot => bot.userId === userId);
    if (!targetBot) {
        return res.status(404).json({ success: false, message: 'Bot not connected' });
    }

    io.to(targetBot.socketId).emit('config_command', {
        command: 'add_boycott_ban',
        serverId,
        payload: { userId: targetUserId, protectedRoles, reason, addedBy: userId },
        timestamp: Date.now()
    });

    res.json({ success: true, message: 'Request sent to bot' });
});

// Remove Boycott Ban
app.delete('/api/server/:serverId/protection/boycott-bans/:targetUserId', ensureAuthenticated, (req, res) => {
    const { serverId, targetUserId } = req.params;
    const userId = req.user.id;

    const targetBot = Array.from(activeBots.values()).find(bot => bot.userId === userId);
    if (!targetBot) {
        return res.status(404).json({ success: false, message: 'Bot not connected' });
    }

    io.to(targetBot.socketId).emit('config_command', {
        command: 'remove_boycott_ban',
        serverId,
        payload: { userId: targetUserId },
        timestamp: Date.now()
    });

    res.json({ success: true, message: 'Request sent to bot' });
});

