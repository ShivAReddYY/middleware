// Bulk release users from quarantine
app.post('/api/quarantine/bulk/release', ensureAuthenticated, (req, res) => {
    const { serverId, userIds } = req.body;
    const userId = req.user.id;

    if (!Array.isArray(userIds)) {
        return res.status(400).json({ success: false, message: 'userIds must be an array' });
    }

    const targetBot = getAnyBotWithServer(serverId);

    if (!targetBot) {
        return res.status(404).json({ success: false, message: 'Server not found' });
    }

    // Send release command for each user
    userIds.forEach(targetUserId => {
        io.to(targetBot.socketId).emit('config_command', {
            command: 'release_user_from_quarantine',
            serverId,
            payload: { userId: targetUserId },
            timestamp: Date.now()
        });
    });

    res.json({
        success: true,
        message: `Release command sent for ${userIds.length} users`,
        processed: userIds.length
    });
});

/* ------------------------------------------------------------------ */
/*  QUARANTINE Analytics                                             */
/* ------------------------------------------------------------------ */
// Get quarantine analytics across all servers
app.get('/api/quarantine/analytics', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    const analytics = {
        totalServers: 0,
        enabledServers: 0,
        disabledServers: 0,
        totalQuarantinedUsers: 0,
        serversWithUsers: 0
    };

    // Calculate analytics from cached configs
    for (const [serverId, config] of botQuarantineConfigs) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            analytics.totalServers++;
            if (config.quarantineEnabled) {
                analytics.enabledServers++;

                const users = botQuarantinedUsers.get(serverId) || [];
                analytics.totalQuarantinedUsers += users.length;
                if (users.length > 0) {
                    analytics.serversWithUsers++;
                }
            } else {
                analytics.disabledServers++;
            }
        }
    }

    res.json({
        success: true,
        analytics
    });
});

// Get quarantine leaderboard (most quarantined users)
app.get('/api/quarantine/leaderboard', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    const leaderboard = [];

    for (const [serverId, config] of botQuarantineConfigs) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot && config.quarantineEnabled) {
            const serverData = targetBot.serverData.find(s => s.id === serverId);
            const users = botQuarantinedUsers.get(serverId) || [];

            leaderboard.push({
                serverId,
                serverName: serverData?.name || 'Unknown',
                memberCount: serverData?.memberCount || 0,
                quarantinedCount: users.length,
                isEnabled: config.quarantineEnabled
            });
        }
    }

    // Sort by quarantined count
    leaderboard.sort((a, b) => b.quarantinedCount - a.quarantinedCount);

    res.json({
        success: true,
        leaderboard: leaderboard.slice(0, 10) // Top 10
    });
});
// Custom Commands Management Routes
/* ------------------------------------------------------------------ */
/*  GET All Custom Commands (Admin Only)                            */
/* ------------------------------------------------------------------ */
app.get('/api/customcommands/all', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;

    debugLogger.logApiRequest('GET', '/api/customcommands/all', { userId });

    // Collect all commands from cache
    const allCommands = [];
    for (const [commandUserId, commands] of botCustomCommands) {
        allCommands.push(...commands);
    }

    // Request fresh data from bot
    const targetBot = Array.from(activeBots.values()).find(bot =>
        bot.userId === userId
    );

    if (targetBot) {
        console.log(`📡 Requesting fresh custom commands data`);
        io.to(targetBot.socketId).emit('config_command', {
            command: 'get_all_customcommands',
            serverId: 'global',
            payload: { requesterId: userId },
            timestamp: Date.now()
        });
    }

    res.json({ success: true, commands: allCommands });
});

/* ------------------------------------------------------------------ */
/*  CREATE / UPDATE Custom Command                                   */
/* ------------------------------------------------------------------ */
app.post('/api/user/:userId/customcommands', ensureAuthenticated, (req, res) => {
    const { userId } = req.params;
    const requesterId = req.user.id;
    const { commandName, response } = req.body;

    debugLogger.logApiRequest('POST', `/api/user/${userId}/customcommands`, {
        userId,
        requesterId,
        commandName
    });

    if (!commandName || !response) {
        return res.status(400).json({ success: false, message: 'commandName and response are required' });
    }

    const targetBot = Array.from(activeBots.values()).find(bot =>
        bot.userId === requesterId
    );

    if (!targetBot) {
        return res.status(404).json({ success: false, message: 'Bot not found' });
    }

    // Send command to bot
    io.to(targetBot.socketId).emit('config_command', {
        command: 'create_update_customcommand',
        serverId: 'global',
        payload: { userId, commandName, response },
        timestamp: Date.now()
    });

    res.json({ success: true, message: 'Command creation/update initiated' });
});

