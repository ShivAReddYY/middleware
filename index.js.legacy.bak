// Get user AFK status
app.get('/api/server/:serverId/afk/user/:userId', ensureAuthenticated, (req, res) => {
    const { serverId, userId } = req.params;
    const requestUserId = req.user.id;

    debugLogger.logApiRequest('GET', `/api/server/${serverId}/afk/user/${userId}`, { serverId, userId, requestUserId });

    const serverData = botAFKData.get(String(serverId));
    const afk = serverData?.users?.get(String(userId)) || null;

    console.log(`🔍 AFK API called for user ${userId} in server ${serverId}, found:`, !!afk);

    // Request fresh data if no config
    if (!afk) {
        const targetBot = Array.from(activeBots.values()).find(bot =>
            bot.userId === requestUserId &&
            bot.serverData.some(s => s.id === serverId)
        );

        if (targetBot) {
            console.log(`📡 Requesting fresh AFK data for user ${userId} in server ${serverId}`);
            io.to(targetBot.socketId).emit('config_command', {
                command: 'get_user_afk',
                serverId,
                payload: { userId },
                timestamp: Date.now()
            });
        }
    }

    res.json({ success: true, afk });
});

// Set user AFK status
app.post('/api/server/:serverId/afk/user/:userId', ensureAuthenticated, (req, res) => {
    const { serverId, userId } = req.params;
    const requestUserId = req.user.id;

    // Users can only set their own AFK status
    if (userId !== requestUserId) {
        return res.status(403).json({ success: false, message: 'Can only set your own AFK status' });
    }

    forwardCommand(req, res, serverId, 'set_user_afk', { userId, ...req.body });
});

// Remove user AFK status  
app.delete('/api/server/:serverId/afk/user/:userId', ensureAuthenticated, (req, res) => {
    const { serverId, userId } = req.params;
    const requestUserId = req.user.id;

    // Users can only remove their own AFK status, or mods can remove others
    if (userId !== requestUserId) {
        // Check if user has manage channels permission (simplified check)
        return res.status(403).json({ success: false, message: 'Insufficient permissions' });
    }

    forwardCommand(req, res, serverId, 'remove_user_afk', { userId });
});

// Get server AFK list (admin only)
app.get('/api/server/:serverId/afk/list', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;
    const { page = 1, limit = 10, status = 'active' } = req.query;

    debugLogger.logApiRequest('GET', `/api/server/${serverId}/afk/list`, { serverId, userId });

    const serverData = botAFKData.get(String(serverId));
    const afks = serverData?.users ? Array.from(serverData.users.values()) : [];

    // Filter by status if specified
    const filteredAFKs = status === 'all' ? afks : afks.filter(afk => afk.status === status);

    // Pagination
    const startIndex = (parseInt(page) - 1) * parseInt(limit);
    const paginatedAFKs = filteredAFKs.slice(startIndex, startIndex + parseInt(limit));

    const pagination = {
        current: parseInt(page),
        total: Math.ceil(filteredAFKs.length / parseInt(limit)),
        hasNext: startIndex + parseInt(limit) < filteredAFKs.length,
        hasPrev: parseInt(page) > 1,
        totalItems: filteredAFKs.length
    };

    console.log(`🔍 AFK list API called for server ${serverId}, found ${filteredAFKs.length} users`);

    // Request fresh data if no server data
    if (!serverData) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            console.log(`📡 Requesting fresh AFK list for server ${serverId}`);
            io.to(targetBot.socketId).emit('config_command', {
                command: 'get_server_afk_list',
                serverId,
                payload: { options: { page: parseInt(page), limit: parseInt(limit), status } },
                timestamp: Date.now()
            });
        }
    }

    res.json({ success: true, afks: paginatedAFKs, pagination });
});

// Get AFK statistics (admin only)
app.get('/api/server/:serverId/afk/stats', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;

    debugLogger.logApiRequest('GET', `/api/server/${serverId}/afk/stats`, { serverId, userId });

    const serverData = botAFKData.get(String(serverId));
    const stats = serverData?.stats || null;

    console.log(`🔍 AFK stats API called for server ${serverId}, found:`, !!stats);

    // Request fresh data if no stats
    if (!stats) {
        const targetBot = getAnyBotWithServer(serverId);

        if (targetBot) {
            console.log(`📡 Requesting fresh AFK stats for server ${serverId}`);
            io.to(targetBot.socketId).emit('config_command', {
                command: 'get_afk_stats',
                serverId,
                payload: {},
