/* ------------------------------------------------------------------ */
/*  SETUP / ENABLE Quarantine System                                 */
/* ------------------------------------------------------------------ */
app.post('/api/server/:serverId/quarantine', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const { quarantineRoleId, quarantineChannelId } = req.body;

    dispatchConfig(req, res, {
        serverId, module: 'quarantine', action: 'setup',
        payload: {
            configData: {
                quarantineRoleId: quarantineRoleId || null,
                quarantineChannelId: quarantineChannelId || null
            }
        }
    });
});

