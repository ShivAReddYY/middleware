        bot.userId === userId
    );

    if (targetBot) {
        io.to(targetBot.socketId).emit('config_command', {
            command: 'get_all_customcommands',
            serverId: 'global',
            payload: { requesterId: userId },
            timestamp: Date.now()
        });
    }

    // Send current cached data immediately
    const allCommands = [];
    for (const [commandUserId, commands] of botCustomCommands) {
        allCommands.push(...commands);
    }

    res.json({
        success: true,
        message: 'Custom commands refresh initiated',
        commands: allCommands
    });
});

