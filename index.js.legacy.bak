app.post('/api/refresh/stickymessage', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    for (const [srvId, configs] of botStickyMessageConfigs) {
        io.to(`user_${userId}`).emit('server_stickymessage_updated', { serverId: srvId, configs });
    }
    res.json({ success: true, message: 'Sticky message data resent' });
});

// ════════════════ EMBEDS SYSTEM API ════════════════
app.get('/api/server/:serverId/embeds', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const { page = 1, limit = 20, category, search } = req.query;
    const cached = botEmbedsData.get(String(serverId));
    if (cached && cached.embeds?.length) {
        // Filter and paginate from cache
        let embeds = cached.embeds;
        if (category) embeds = embeds.filter(e => e.category === category);
        if (search) {
            const s = search.toLowerCase();
            embeds = embeds.filter(e => (e.name || '').toLowerCase().includes(s) || (e.title || '').toLowerCase().includes(s) || (e.embedId || '').toLowerCase().includes(s));
        }
        const startIdx = (parseInt(page) - 1) * parseInt(limit);
        const paged = embeds.slice(startIdx, startIdx + parseInt(limit));
        const pagination = { current: parseInt(page), total: Math.ceil(embeds.length / parseInt(limit)), totalItems: embeds.length };
        return res.json({ success: true, embeds: paged, pagination });
    }
    // Forward to bot for fresh data
    const targetBot = getAnyBotWithServer(serverId);
    if (targetBot) {
        io.to(targetBot.socketId).emit('config_command', { command: 'get_embeds', serverId, payload: { options: { page: parseInt(page), limit: parseInt(limit), category, search } }, timestamp: Date.now() });
    }
    res.json({ success: true, embeds: [], pagination: { current: 1, total: 0, totalItems: 0 } });
});
app.post('/api/server/:serverId/embeds', ensureAuthenticated, (req, res) => {
    forwardCommand(req, res, req.params.serverId, 'create_embed', { userId: req.user.id, embedData: req.body });
});
app.put('/api/server/:serverId/embeds/:embedId', ensureAuthenticated, (req, res) => {
    forwardCommand(req, res, req.params.serverId, 'update_embed', { embedId: req.params.embedId, userId: req.user.id, embedData: req.body });
});
app.delete('/api/server/:serverId/embeds/:embedId', ensureAuthenticated, (req, res) => {
    forwardCommand(req, res, req.params.serverId, 'delete_embed', { embedId: req.params.embedId });
});
app.post('/api/server/:serverId/embeds/:embedId/clone', ensureAuthenticated, (req, res) => {
    forwardCommand(req, res, req.params.serverId, 'clone_embed', { embedId: req.params.embedId, userId: req.user.id, newName: req.body.newName });
});
app.post('/api/server/:serverId/embeds/:embedId/send', ensureAuthenticated, (req, res) => {
    forwardCommand(req, res, req.params.serverId, 'send_embed_to_channel', { embedId: req.params.embedId, channelId: req.body.channelId, options: req.body.options || {} });
});
// Schedule routes
app.get('/api/server/:serverId/embeds/schedules/list', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const cached = botEmbedsData.get(String(serverId));
    if (cached && cached.schedules?.length) {
        return res.json({ success: true, schedules: cached.schedules });
    }
    const targetBot = getAnyBotWithServer(serverId);
    if (targetBot) {
        io.to(targetBot.socketId).emit('config_command', { command: 'get_embed_schedules', serverId, payload: {}, timestamp: Date.now() });
    }
    res.json({ success: true, schedules: [] });
});
app.post('/api/server/:serverId/embeds/schedules', ensureAuthenticated, (req, res) => {
    forwardCommand(req, res, req.params.serverId, 'create_embed_schedule', { userId: req.user.id, scheduleData: req.body });
});
app.patch('/api/server/:serverId/embeds/schedules/:scheduleId/toggle', ensureAuthenticated, (req, res) => {
    forwardCommand(req, res, req.params.serverId, 'toggle_embed_schedule', { scheduleId: req.params.scheduleId });
});
app.delete('/api/server/:serverId/embeds/schedules/:scheduleId', ensureAuthenticated, (req, res) => {
    forwardCommand(req, res, req.params.serverId, 'delete_embed_schedule', { scheduleId: req.params.scheduleId });
});
app.post('/api/refresh/embeds', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    for (const [srvId, data] of botEmbedsData) {
        io.to(`user_${userId}`).emit('server_embeds_updated', { serverId: srvId, data });
    }
    res.json({ success: true, message: 'Embeds data resent' });
});

// Server status endpoint
app.get('/api/server-status', (req, res) => {
    const status = {
        serverOnline: true,
        activeBots: activeBots.size,
        activeUsers: userSessions.size,
        uptime: process.uptime(),
        memory: process.memoryUsage()
    };

    debugLogger.logApiRequest('GET', '/api/server-status', {}, { status: 200, ...status });
    res.json(status);
});

// Health check for bots
setInterval(() => {
    const now = Date.now();
    const staleThreshold = 2 * 60 * 1000; // 2 minutes
    let removedBots = 0;

    for (const [botId, bot] of activeBots) {
        if (now - bot.lastHeartbeat > staleThreshold) {
            activeBots.delete(botId);
            removedBots++;

            debugLogger.logEvent('system', 'stale_bot_removed', {
                botId,
                userId: bot.userId,
                lastHeartbeat: new Date(bot.lastHeartbeat).toISOString()
            });
        }
    }

    if (removedBots > 0) {
        debugLogger.updateActiveBots(activeBots);
        debugLogger.updateStatistics(activeBots, userSessions);
        console.log(`🧹 Cleaned up ${removedBots} stale bots`);
    }
}, 60000); // Every 60 seconds

app.get('/', (req, res) => {
    res.status(200).send(`
        <!DOCTYPE html>
        <html>
        <head>
            <title>Discord Bot Manager - Online</title>
            <meta charset="UTF-8">
        </head>
        <body>
            <h1>🤖 Discord Bot Manager</h1>
            <p>Server Status: <strong style="color: green;">ONLINE</strong></p>
            <p>Uptime: ${process.uptime()} seconds</p>
            <p>Last Check: ${new Date().toISOString()}</p>
            <script>
                // Auto refresh every 5 minutes to show activity
                setTimeout(() => location.reload(), 300000);
            </script>
        </body>
        </html>
    `);
});
// Start server
server.listen(PORT, '0.0.0.0', () => {
    console.log(`🚀 Server running on http://localhost:${PORT}`);
    console.log(`📡 Socket.IO enabled at ws://localhost:${PORT}`);
    debugLogger.logEvent('system', 'server_started', {
        port: PORT,
        env: process.env.NODE_ENV || 'development'
    });
});
