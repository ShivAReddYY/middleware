// Server Stats Routes
app.get('/api/server/:serverId/serverstats', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;

    const serverStats = botServerStatsData.get(serverId) || null;

    if (!serverStats) {
        const targetBot = getAnyBotWithServer(serverId);
        if (targetBot) {
            io.to(targetBot.socketId).emit('config_command', {
                command: 'get_serverstats_config',
                serverId,
                payload: {},
                timestamp: Date.now()
            });
        }
    }

    res.json({ success: true, serverStats });
});

app.post('/api/server/:serverId/serverstats/setup', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;

    const targetBot = getAnyBotWithServer(serverId);
    if (!targetBot) {
        return res.status(404).json({ success: false, message: 'Bot not connected' });
    }

    io.to(targetBot.socketId).emit('config_command', {
        command: 'setup_serverstats',
        serverId,
        payload: { options: req.body },
        timestamp: Date.now()
    });

    res.json({ success: true, message: 'Request sent to bot' });
});

app.delete('/api/server/:serverId/serverstats/channel/:type', ensureAuthenticated, (req, res) => {
    const { serverId, type } = req.params;
    const userId = req.user.id;

    const targetBot = getAnyBotWithServer(serverId);
    if (!targetBot) {
        return res.status(404).json({ success: false, message: 'Bot not connected' });
    }

    io.to(targetBot.socketId).emit('config_command', {
        command: 'remove_serverstats_channel',
        serverId,
        payload: { type },
        timestamp: Date.now()
    });

    res.json({ success: true, message: 'Request sent to bot' });
});

app.delete('/api/server/:serverId/serverstats', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const userId = req.user.id;

    const targetBot = getAnyBotWithServer(serverId);
