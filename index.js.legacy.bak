});

// Add API key (server-scoped)
app.post('/api/gemini/keys', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    const { serverId } = req.body;

    if (!serverId) {
        return res.status(400).json({ success: false, message: 'serverId is required' });
    }

    console.log(`📤 Adding new Gemini API key for server ${serverId} by user ${userId}`, req.body);

    const targetBot = Array.from(activeBots.values()).find(bot => bot.userId === userId);
    if (!targetBot) {
        console.log(`❌ No active bot found for user ${userId}`);
        return res.status(404).json({
            success: false,
            message: 'Bot not connected. Please make sure your bot is online.'
        });
    }

    io.to(targetBot.socketId).emit('config_command', {
        command: 'add_gemini_api_key',
        serverId, // Root level for bot compatibility
        payload: {
            serverId,
            options: {
                ...req.body,
                serverId,
                addedBy: userId
            }
        },
        timestamp: Date.now()
    });

    res.json({ success: true, message: 'Request sent to bot', serverId });
});

