// ════════════════ BIRTHDAY SYSTEM API ════════════════
app.get('/api/server/:serverId/birthday', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const config = botBirthdayConfigs.get(String(serverId)) || null;
    if (!config) {
        const targetBot = getAnyBotWithServer(serverId);
        if (targetBot) {
            io.to(targetBot.socketId).emit('config_command', { command: 'get_birthday_config', serverId, payload: {}, timestamp: Date.now() });
        }
    }
    res.json({ success: true, config });
});
app.post('/api/server/:serverId/birthday', ensureAuthenticated, (req, res) => {
    forwardCommand(req, res, req.params.serverId, 'setup_birthday_system', req.body);
});
app.put('/api/server/:serverId/birthday', ensureAuthenticated, (req, res) => {
    forwardCommand(req, res, req.params.serverId, 'update_birthday_config', req.body);
});
app.delete('/api/server/:serverId/birthday', ensureAuthenticated, (req, res) => {
    forwardCommand(req, res, req.params.serverId, 'delete_birthday_config', {});
});
app.get('/api/server/:serverId/birthday/upcoming', ensureAuthenticated, (req, res) => {
    forwardCommand(req, res, req.params.serverId, 'get_upcoming_birthdays', { days: parseInt(req.query.days) || 30 });
});
app.post('/api/refresh/birthday', ensureAuthenticated, (req, res) => {
    const userId = req.user.id;
    for (const [srvId, config] of botBirthdayConfigs) {
        io.to(`user_${userId}`).emit('server_birthday_updated', { serverId: srvId, config });
    }
    res.json({ success: true, message: 'Birthday data resent' });
});

