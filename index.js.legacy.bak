            case 'serverconfig_permission_check':
                io.to(`user_${botData.userId}`).emit(type, payload);
                debugLogger.logEvent('socket', type, payload);
                break;
            // Verification configuration
            case 'verification_config': {
                const guildId = String(payload.guildId);
                botVerificationConfigs.set(guildId, payload);

                io.to(`user_${botData.userId}`).emit('server_verification_updated', {
