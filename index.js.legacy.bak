/*  SETUP Event Logging for Specific Server                         */
/* ------------------------------------------------------------------ */
app.post('/api/server/:serverId/serverlogs/event', ensureAuthenticated, (req, res) => {
    const { serverId } = req.params;
    const { eventType, channelId } = req.body;

    if (!eventType || !channelId) {
        return res.status(400).json({ success: false, message: 'eventType and channelId are required' });
    }

    // Validate channel ID format
    if (!/^\d{17,19}$/.test(channelId)) {
        return res.status(400).json({ success: false, message: 'Invalid channel ID format' });
    }

    const payload = {
        eventType,
        channelId
    };
    forwardCommand(req, res, serverId, 'setup_event_logging', payload);
});

